@@ -0,0 +1,46 @@
+import * as Effect from "effect/Effect";
+import type { ElectronDialogShowMessageBoxError } from "../electron/ElectronDialog.ts";
+
+export type HomebrewServiceInspection =
+  | { readonly _tag: "verified"; readonly unit: string; readonly environmentId: string; readonly origin: string; readonly fingerprint: string; readonly pairingCompatible: boolean }
+  | { readonly _tag: "inactive"; readonly unit: string }
+  | { readonly _tag: "unverified" };
+type VerifiedOwner = Extract<HomebrewServiceInspection, { _tag: "verified" }>;
+
+export const prepareHomebrewServiceRecovery = Effect.fn("homebrewServiceRecovery.prepare")(
+  function* (actions: {
+    readonly inspect: () => Effect.Effect<HomebrewServiceInspection>;
+    readonly choose: (owner: VerifiedOwner) => Effect.Effect<number, ElectronDialogShowMessageBoxError>;
+    readonly pair: (fingerprint: string) => Effect.Effect<string | null>;
+  }) {
+    const owner = yield* actions.inspect();
+    if (owner._tag !== "verified") return owner;
+    const choice = yield* actions.choose(owner);
+    if (choice === 2 || (choice !== 0 && choice !== 1)) return { _tag: "quit" } as const;
+    if (choice === 1) return { _tag: "open", pairingLink: null, pairingRequested: false, expectedOwner: null } as const;
+    if (!owner.pairingCompatible) return { _tag: "open", pairingLink: null, pairingRequested: true, expectedOwner: owner } as const;
+
+    const current = yield* actions.inspect();
+    let pairingLink: string | null = null;
+    if (current._tag === "verified" && current.unit === owner.unit && current.fingerprint === owner.fingerprint && current.pairingCompatible) {
+      pairingLink = yield* actions.pair(owner.fingerprint);
+      const finalOwner = yield* actions.inspect();
+      if (finalOwner._tag !== "verified" || finalOwner.unit !== owner.unit || finalOwner.fingerprint !== owner.fingerprint || !finalOwner.pairingCompatible) pairingLink = null;
+    }
+    return { _tag: "open", pairingLink, pairingRequested: true, expectedOwner: owner } as const;
+  },
+);
+
+export const deliverHomebrewServicePairing = Effect.fn("homebrewServiceRecovery.deliver")(
+  function* (input: {
+    readonly expectedOwner: VerifiedOwner;
+    readonly pairingLink: string;
+    readonly inspect: () => Effect.Effect<HomebrewServiceInspection>;
+    readonly deliver: (link: string) => Effect.Effect<void>;
+  }) {
+    const current = yield* input.inspect();
+    if (current._tag !== "verified" || !current.pairingCompatible || current.unit !== input.expectedOwner.unit || current.fingerprint !== input.expectedOwner.fingerprint) return false;
+    yield* input.deliver(input.pairingLink);
+    return true;
+  },
+);
