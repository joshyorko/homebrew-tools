@@ -0,0 +1,330 @@
+import * as NodeSqlite from "node:sqlite";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { assert, describe, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as FileSystem from "effect/FileSystem";
+import * as HttpClient from "effect/http/HttpClient";
+import * as NetService from "@t3tools/shared/Net";
+import { ChildProcessSpawner } from "effect/process";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import type * as Scope from "effect/Scope";
+import * as TestClock from "effect/testing/TestClock";
+import { afterEach, vi } from "vite-plus/test";
+
+const desktop = vi.hoisted(() => ({ urls: Array<string>(), links: Array<string>() }));
+vi.mock("electron", () => ({
+  app: {
+    emit: (_event: string, _input: unknown, link: string) => {
+      desktop.links.push(link);
+      return true;
+    },
+  },
+  BrowserWindow: class {
+    async loadURL(url: string) {
+      desktop.urls.push(url);
+    }
+  },
+}));
+vi.mock("@clerk/electron", () => ({ createClerkBridge: vi.fn() }));
+vi.mock("@clerk/electron/storage", () => ({ storage: vi.fn() }));
+vi.mock("../ipc/DesktopIpcHandlers.ts", () => ({ installDesktopIpcHandlers: () => Effect.void }));
+vi.mock("../updates/DesktopRemoteUpdates.ts", () => ({ listen: Effect.void }));
+vi.mock("./DesktopStartupRecovery.ts", () => ({ listen: Effect.void }));
+
+import * as Electron from "electron";
+import * as DesktopApp from "./DesktopApp.ts";
+import * as DesktopAppActivation from "./DesktopAppActivation.ts";
+import * as DesktopAppIdentity from "./DesktopAppIdentity.ts";
+import * as DesktopConfig from "./DesktopConfig.ts";
+import * as DesktopEnvironment from "./DesktopEnvironment.ts";
+import * as DesktopLegacyLocalStorage from "./DesktopLegacyLocalStorage.ts";
+import * as DesktopState from "./DesktopState.ts";
+import * as DesktopShutdown from "./DesktopShutdown.ts";
+import * as DesktopLifecycle from "./DesktopLifecycle.ts";
+import * as DesktopUpdates from "../updates/DesktopUpdates.ts";
+import * as DesktopBackendPool from "../backend/DesktopBackendPool.ts";
+import * as DesktopServerExposure from "../backend/DesktopServerExposure.ts";
+import * as DesktopWslBackend from "../wsl/DesktopWslBackend.ts";
+import * as HomebrewServiceOwnerProbe from "../backend/HomebrewServiceOwnerProbe.ts";
+import type { HomebrewServiceInspection } from "../backend/HomebrewServiceRecovery.ts";
+import * as ElectronApp from "../electron/ElectronApp.ts";
+import * as ElectronDialog from "../electron/ElectronDialog.ts";
+import * as ElectronProtocol from "../electron/ElectronProtocol.ts";
+import * as DesktopAppSettings from "../settings/DesktopAppSettings.ts";
+import * as DesktopShellEnvironment from "../shell/DesktopShellEnvironment.ts";
+import * as DesktopSnapShot from "../snapShot/DesktopSnapShot.ts";
+import * as DesktopWindow from "../window/DesktopWindow.ts";
+
+import * as BrowserImport from "../preview/BrowserImport/BrowserImport.ts";
+import * as DesktopBackendConfiguration from "../backend/DesktopBackendConfiguration.ts";
+import * as DesktopCliCommand from "./DesktopCliCommand.ts";
+import * as DesktopClientSettings from "../settings/DesktopClientSettings.ts";
+import * as DesktopConnectionCatalogStore from "./DesktopConnectionCatalogStore.ts";
+import * as DesktopIpc from "../ipc/DesktopIpc.ts";
+import * as DesktopLocalEnvironmentAuth from "../backend/DesktopLocalEnvironmentAuth.ts";
+import * as DesktopManagedPolicy from "./DesktopManagedPolicy.ts";
+import * as DesktopPrimaryPaste from "./DesktopPrimaryPaste.ts";
+import * as DesktopSshEnvironment from "../ssh/DesktopSshEnvironment.ts";
+import * as DesktopSshPasswordPrompts from "../ssh/DesktopSshPasswordPrompts.ts";
+import * as DesktopTelemetryPublisher from "../telemetry/DesktopTelemetryPublisher.ts";
+import * as DesktopWebLinks from "./DesktopWebLinks.ts";
+import * as DesktopWslEnvironment from "../wsl/DesktopWslEnvironment.ts";
+import * as ElectronMenu from "../electron/ElectronMenu.ts";
+import * as ElectronShell from "../electron/ElectronShell.ts";
+import * as ElectronTheme from "../electron/ElectronTheme.ts";
+import * as ElectronWindow from "../electron/ElectronWindow.ts";
+import * as MacPermissions from "../permissions/MacPermissions.ts";
+import * as PreviewManager from "../preview/Manager.ts";
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  desktop.urls.length = 0;
+  desktop.links.length = 0;
+});
+
+const owner = {
+  _tag: "verified",
+  unit: "homebrew.t3code-cli-main.service",
+  environmentId: "homebrew-fixture",
+  origin: "http://127.0.0.1:3773",
+  fingerprint: "verified-owner",
+  pairingCompatible: true,
+} satisfies HomebrewServiceInspection;
+
+const withStartup = <A, E>(
+  input: {
+    choice?: number;
+    inspection?: HomebrewServiceInspection;
+    localEnvironmentEnabled?: boolean;
+  },
+  check: (fixture: {
+    run: Effect.Effect<void, Effect.Error<typeof DesktopApp.bootstrap>, Scope.Scope>;
+    lock: NodeSqlite.DatabaseSync;
+    events: string[];
+    settings: DesktopAppSettings.DesktopAppSettings["Service"];
+  }) => Effect.Effect<A, E, Scope.Scope>,
+) =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const home = yield* fs.makeTempDirectoryScoped({ prefix: "t3-homebrew-bootstrap-" });
+    yield* fs.makeDirectory(`${home}/userdata`);
+    const lock = yield* Effect.acquireRelease(
+      Effect.sync(() => {
+        const db = new NodeSqlite.DatabaseSync(`${home}/userdata/server-owner.sqlite`);
+        db.exec("BEGIN EXCLUSIVE");
+        return db;
+      }),
+      (db) =>
+        Effect.sync(() => {
+          if (db.isOpen) db.close();
+        }),
+    );
+    const events: string[] = [];
+    const record = (event: string) =>
+      Effect.sync(() => {
+        events.push(event);
+      });
+    vi.spyOn(HomebrewServiceOwnerProbe, "inspectHomebrewServiceOwner").mockImplementation(() =>
+      Effect.succeed(input.inspection ?? owner),
+    );
+    vi.spyOn(HomebrewServiceOwnerProbe, "createHomebrewServicePairingAppLink").mockImplementation(
+      () => Effect.succeed("t3code://pair?fixture"),
+    );
+    vi.spyOn(HomebrewServiceOwnerProbe, "backupHomebrewDesktopSettings").mockImplementation(() =>
+      record("backup").pipe(Effect.as(null)),
+    );
+    const settings = yield* DesktopAppSettings.DesktopAppSettings;
+    const primary = {
+      id: DesktopBackendPool.PRIMARY_INSTANCE_ID,
+      label: Effect.succeed("Local"),
+      start: record("backend-start"),
+      stop: () => record("backend-stop"),
+      currentConfig: Effect.succeedNone,
+      snapshot: Effect.succeed({
+        desiredRunning: false,
+        ready: false,
+        activePid: Option.none(),
+        restartAttempt: 0,
+        restartScheduled: false,
+      }),
+      waitForReady: () => Effect.succeed(true),
+    } satisfies DesktopBackendPool.DesktopBackendInstance;
+    const layer = Layer.mergeAll(
+      Layer.mock(NetService.NetService, {}),
+      Layer.succeed(
+        HttpClient.HttpClient,
+        HttpClient.make(() => Effect.die("unexpected HTTP request")),
+      ),
+      Layer.mock(DesktopShutdown.DesktopShutdown, {}),
+      Layer.mock(DesktopLifecycle.DesktopLifecycle, {}),
+      Layer.mock(DesktopUpdates.DesktopUpdates, {}),
+      DesktopState.layer,
+      Layer.mock(BrowserImport.BrowserImport, {}),
+      Layer.mock(ChildProcessSpawner.ChildProcessSpawner, {}),
+      Layer.mock(DesktopBackendConfiguration.DesktopBackendConfiguration, {}),
+      Layer.mock(DesktopClientSettings.DesktopClientSettings, {}),
+      Layer.mock(DesktopConnectionCatalogStore.DesktopConnectionCatalogStore, {}),
+      Layer.mock(DesktopIpc.DesktopIpc, {}),
+      Layer.mock(DesktopLocalEnvironmentAuth.DesktopLocalEnvironmentAuth, {}),
+      Layer.mock(DesktopManagedPolicy.DesktopManagedPolicy, {}),
+      Layer.succeed(DesktopPrimaryPaste.DesktopPrimaryPaste, { enabled: true }),
+      Layer.mock(DesktopSshEnvironment.DesktopSshEnvironment, {}),
+      Layer.mock(DesktopSshPasswordPrompts.DesktopSshPasswordPrompts, {}),
+      Layer.mock(DesktopTelemetryPublisher.DesktopTelemetryPublisher, {}),
+      Layer.mock(DesktopWebLinks.DesktopWebLinks, {}),
+      Layer.mock(DesktopWslEnvironment.DesktopWslEnvironment, {}),
+      Layer.mock(ElectronMenu.ElectronMenu, {}),
+      Layer.mock(ElectronShell.ElectronShell, {}),
+      Layer.mock(ElectronTheme.ElectronTheme, {}),
+      Layer.mock(ElectronWindow.ElectronWindow, {}),
+      Layer.mock(MacPermissions.MacPermissions, {}),
+      Layer.mock(PreviewManager.PreviewManager, {
+        isBrowserPartition: () => {
+          throw new Error("unexpected browser partition lookup");
+        },
+      }),
+      DesktopBackendPool.layerTest([primary]),
+      Layer.mock(DesktopAppActivation.DesktopAppActivation, { start: Effect.void }),
+      Layer.mock(DesktopAppIdentity.DesktopAppIdentity, {
+        resolveUserDataPath: Effect.succeed(`${home}/userdata`),
+      }),
+      Layer.mock(DesktopCliCommand.DesktopCliCommand, { installOnFirstLaunch: Effect.void }),
+      Layer.mock(DesktopLegacyLocalStorage.DesktopLegacyLocalStorage, { load: () => Effect.void }),
+      Layer.mock(DesktopSnapShot.DesktopSnapShot, { initialize: Effect.void }),
+      Layer.mock(DesktopShellEnvironment.DesktopShellEnvironment, {
+        awaitUserShellDiscovery: Effect.succeed(false),
+      }),
+      Layer.mock(DesktopWindow.DesktopWindow, {
+        createMainIfBackendReady: record("window"),
+        ensureMain: Effect.sync(() => new Electron.BrowserWindow()),
+      }),
+      Layer.mock(ElectronApp.ElectronApp, { quit: record("quit") }),
+      Layer.mock(ElectronDialog.ElectronDialog, {
+        showMessageBox: () =>
+          record("recovery-dialog").pipe(
+            Effect.as({ response: input.choice ?? 0, checkboxChecked: false }),
+          ),
+        showErrorBox: () => record("error-dialog"),
+      }),
+      Layer.mock(ElectronProtocol.ElectronProtocol, { registerDesktopProtocol: () => Effect.void }),
+      Layer.mock(DesktopServerExposure.DesktopServerExposure, {
+        configureFromSettings: () =>
+          Effect.succeed({
+            mode: "local-only",
+            endpointUrl: null,
+            advertisedHost: null,
+            tailscaleServeEnabled: false,
+            tailscaleServePort: 443,
+          }),
+        backendConfig: Effect.succeed({
+          httpBaseUrl: new URL("http://127.0.0.1:3773"),
+          port: 3773,
+          bindHost: "127.0.0.1",
+          tailscaleServeEnabled: false,
+          tailscaleServePort: 443,
+        }),
+      }),
+      Layer.mock(DesktopWslBackend.DesktopWslBackend, { reconcile: Effect.void }),
+      DesktopEnvironment.layer({
+        dirname: "/repo/apps/desktop/src",
+        homeDirectory: home,
+        platform: "linux",
+        processArch: "x64",
+        appVersion: "1.2.3",
+        appPath: "/repo",
+        isPackaged: true,
+        resourcesPath: "/missing/resources",
+        runningUnderArm64Translation: false,
+      }).pipe(
+        Layer.provide(
+          Layer.mergeAll(
+            NodeServices.layer,
+            DesktopConfig.layerTest({ T3CODE_HOME: home, T3CODE_PORT: "3773" }),
+          ),
+        ),
+        Layer.orDie,
+      ),
+    );
+    yield* check({
+      run: DesktopApp.bootstrap.pipe(
+        Effect.provide(layer),
+        Effect.provideService(DesktopAppSettings.DesktopAppSettings, settings),
+        Effect.provide(NodeServices.layer),
+      ),
+      lock,
+      events,
+      settings,
+    });
+  }).pipe(
+    Effect.provide(
+      DesktopAppSettings.layerTest({
+        ...DesktopAppSettings.DEFAULT_DESKTOP_SETTINGS,
+        localEnvironmentEnabled: input.localEnvironmentEnabled ?? true,
+      }),
+    ),
+    Effect.provide(NodeServices.layer),
+  );
+
+describe("Homebrew service recovery during actual Desktop bootstrap", () => {
+  it.effect("waits for the ownership grace, then connects without starting a local backend", () =>
+    withStartup({}, (f) =>
+      Effect.gen(function* () {
+        const boot = yield* Effect.forkChild(f.run);
+        yield* TestClock.adjust("5 seconds");
+        assert.deepEqual(f.events, []);
+        yield* TestClock.adjust("6 seconds");
+        yield* Fiber.join(boot);
+        assert.deepEqual(f.events, ["recovery-dialog", "backup", "window"]);
+        assert.isFalse((yield* f.settings.get).localEnvironmentEnabled);
+        assert.deepEqual(desktop.links, ["t3code://pair?fixture"]);
+      }),
+    ),
+  );
+
+  for (const [name, input, expected] of [
+    ["cancelled", { choice: 2 }, ["recovery-dialog", "quit"]],
+    ["unverified", { inspection: { _tag: "unverified" } }, ["error-dialog", "quit"]],
+  ] satisfies [string, { choice?: number; inspection?: HomebrewServiceInspection }, string[]][]) {
+    it.effect(`refuses ${name} recovery without changing settings or starting a backend`, () =>
+      withStartup(input, (f) =>
+        Effect.gen(function* () {
+          const boot = yield* Effect.forkChild(f.run);
+          yield* TestClock.adjust("11 seconds");
+          yield* Fiber.join(boot);
+          assert.deepEqual(f.events, expected);
+          assert.isTrue((yield* f.settings.get).localEnvironmentEnabled);
+          assert.deepEqual(desktop.links, []);
+          assert.deepEqual(desktop.urls, []);
+        }),
+      ),
+    );
+  }
+
+  it.effect("starts normally when a transient ownership lock clears during the grace", () =>
+    withStartup({}, (f) =>
+      Effect.gen(function* () {
+        const boot = yield* Effect.forkChild(f.run);
+        yield* TestClock.adjust("5 seconds");
+        assert.deepEqual(f.events, []);
+        f.lock.close();
+        yield* TestClock.adjust("1 second");
+        yield* Fiber.join(boot);
+        assert.deepEqual(f.events, ["backend-start"]);
+        assert.isTrue((yield* f.settings.get).localEnvironmentEnabled);
+        assert.deepEqual(desktop.links, []);
+      }),
+    ),
+  );
+
+  it.effect("keeps local-environment-disabled startup independent of the ownership lock", () =>
+    withStartup({ localEnvironmentEnabled: false }, (f) =>
+      Effect.gen(function* () {
+        yield* f.run;
+        assert.deepEqual(f.events, ["window"]);
+        assert.isFalse((yield* f.settings.get).localEnvironmentEnabled);
+      }),
+    ),
+  );
+});
