+// @effect-diagnostics nodeBuiltinImport:off -- Backup assertions exercise actual private Desktop settings files.
+import { mkdtemp, writeFile, readFile, stat, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { backupDesktopSettingsFile } from "./HomebrewServiceOwnerProbe.ts";
+import { assert, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import { prepareHomebrewServiceRecovery, deliverHomebrewServicePairing, type HomebrewServiceInspection } from "./HomebrewServiceRecovery.ts";
+
+const owner = { _tag: "verified", unit: "t3code-homebrew.service", environmentId: "existing-env", origin: "http://127.0.0.1:3773/", fingerprint: "original-process-and-lock", pairingCompatible: true } satisfies HomebrewServiceInspection;
+
+it.effect("invokes discovery and binds an approved pairing to the unchanged owner", () => Effect.gen(function* () {
+  let inspections = 0;
+  const paired: string[] = [];
+  const result = yield* prepareHomebrewServiceRecovery({
+    inspect: () => Effect.sync(() => { inspections++; return owner; }),
+    choose: () => Effect.succeed(0),
+    pair: (fingerprint) => Effect.sync(() => { paired.push(fingerprint); return "t3code://pair?fixture"; }),
+  });
+  assert.equal(inspections, 3);
+  assert.deepEqual(paired, [owner.fingerprint]);
+  assert.deepEqual(result, { _tag: "open", pairingLink: "t3code://pair?fixture", pairingRequested: true, expectedOwner: owner });
+}));
+
+it.effect.each([2, 3])("refuses an owner change at inspection %s", (changeAt) => Effect.gen(function* () {
+  let inspections = 0;
+  let pairCount = 0;
+  const result = yield* prepareHomebrewServiceRecovery({
+    inspect: () => Effect.sync(() => (++inspections === changeAt ? { ...owner, fingerprint: "replacement-process" } : owner)),
+    choose: () => Effect.succeed(0),
+    pair: () => Effect.sync(() => { pairCount++; return "t3code://pair?fixture"; }),
+  });
+  assert.deepEqual(result, { _tag: "open", pairingLink: null, pairingRequested: true, expectedOwner: owner });
+  assert.equal(pairCount, changeAt === 2 ? 0 : 1);
+}));
+
+it.effect("never mints a credential when the user cancels or the owner is unknown", () => Effect.gen(function* () {
+  for (const inspection of [owner, { _tag: "unverified" } satisfies HomebrewServiceInspection]) {
+    const result = yield* prepareHomebrewServiceRecovery({
+      inspect: () => Effect.succeed(inspection),
+      choose: () => Effect.succeed(2),
+      pair: () => Effect.die("unauthorized pairing"),
+    });
+    assert.equal(result._tag, inspection._tag === "verified" ? "quit" : "unverified");
+  }
+}));
+
+it("backs up the exact Desktop-only settings privately without overwriting earlier backups", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "t3-desktop-settings-backup-"));
+  const settingsPath = join(dir, "desktop-settings.json");
+  const original = '{"localEnvironmentEnabled":true,"customExistingKey":"preserved"}\n';
+  try {
+    assert.isNull(await backupDesktopSettingsFile(settingsPath));
+    await writeFile(settingsPath, original);
+    const first = await backupDesktopSettingsFile(settingsPath);
+    const second = await backupDesktopSettingsFile(settingsPath);
+    if (first === null || second === null) throw new Error("Expected backups");
+    assert.notEqual(first, second);
+    assert.equal(await readFile(first, "utf8"), original);
+    assert.equal(await readFile(second, "utf8"), original);
+    assert.equal(await readFile(settingsPath, "utf8"), original);
+    assert.equal((await stat(first)).mode & 0o777, 0o600);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+});
+
+it.effect("does not mint against an unknown or different source package", () => Effect.gen(function* () {
+  const incompatible = { ...owner, pairingCompatible: false };
+  const result = yield* prepareHomebrewServiceRecovery({
+    inspect: () => Effect.succeed(incompatible), choose: () => Effect.succeed(0),
+    pair: () => Effect.die("must not open the authentication database"),
+  });
+  assert.deepEqual(result, { _tag: "open", pairingLink: null, pairingRequested: true, expectedOwner: incompatible });
+}));
+
+it.effect("rechecks after settings/window work immediately before delivering the credential", () => Effect.gen(function* () {
+  const delivered: string[] = [];
+  for (const fingerprint of ["replacement-after-window-open", owner.fingerprint]) {
+    const accepted = yield* deliverHomebrewServicePairing({
+      expectedOwner: owner, pairingLink: "t3code://pair?fixture",
+      inspect: () => Effect.succeed({ ...owner, fingerprint }),
+      deliver: (link) => Effect.sync(() => { delivered.push(link); }),
+    });
+    assert.equal(accepted, fingerprint === owner.fingerprint);
+  }
+  assert.deepEqual(delivered, ["t3code://pair?fixture"]);
+}));
+
+it.effect("opens the manual recovery path without minting when settings is chosen", () => Effect.gen(function* () {
+  const result = yield* prepareHomebrewServiceRecovery({
+    inspect: () => Effect.succeed(owner), choose: () => Effect.succeed(1),
+    pair: () => Effect.die("manual settings must not mint a credential"),
+  });
+  assert.deepEqual(result, { _tag: "open", pairingLink: null, pairingRequested: false, expectedOwner: null });
+}));
diff --git a/apps/desktop/src/backend/HomebrewServiceRecovery.ts b/apps/desktop/src/backend/HomebrewServiceRecovery.ts
new file mode 100644
index 0000000..0196f75
--- /dev/null
+++ b/apps/desktop/src/backend/HomebrewServiceRecovery.ts
@@ -0,0 +1,46 @@
+import * as Effect from "effect/Effect";
+import type { ElectronDialogShowMessageBoxError } from "../electron/ElectronDialog.ts";
+
+export type HomebrewServiceInspection =
+  | { readonly _tag: "verified"; readonly unit: string; readonly environmentId: string; readonly origin: string; readonly fingerprint: string; readonly pairingCompatible: boolean }
+  | { readonly _tag: "inactive"; readonly unit: string }
+  | { readonly _tag: "unverified" };
+type VerifiedOwner = Extract<HomebrewServiceInspection, { _tag: "verified" }>;
+
+export const prepareHomebrewServiceRecovery = Effect.fn("homebrewServiceRecovery.prepare")(
+  function* (actions: {
+    readonly inspect: () => Effect.Effect<HomebrewServiceInspection>;
+    readonly choose: (owner: VerifiedOwner) => Effect.Effect<number, ElectronDialogShowMessageBoxError>;
+    readonly pair: (fingerprint: string) => Effect.Effect<string | null>;
+  }) {
+    const owner = yield* actions.inspect();
+    if (owner._tag !== "verified") return owner;
+    const choice = yield* actions.choose(owner);
+    if (choice === 2 || (choice !== 0 && choice !== 1)) return { _tag: "quit" } as const;
+    if (choice === 1) return { _tag: "open", pairingLink: null, pairingRequested: false, expectedOwner: null } as const;
+    if (!owner.pairingCompatible) return { _tag: "open", pairingLink: null, pairingRequested: true, expectedOwner: owner } as const;
+
+    const current = yield* actions.inspect();
+    let pairingLink: string | null = null;
+    if (current._tag === "verified" && current.unit === owner.unit && current.fingerprint === owner.fingerprint && current.pairingCompatible) {
+      pairingLink = yield* actions.pair(owner.fingerprint);
+      const finalOwner = yield* actions.inspect();
+      if (finalOwner._tag !== "verified" || finalOwner.unit !== owner.unit || finalOwner.fingerprint !== owner.fingerprint || !finalOwner.pairingCompatible) pairingLink = null;
+    }
+    return { _tag: "open", pairingLink, pairingRequested: true, expectedOwner: owner } as const;
+  },
+);
+
+export const deliverHomebrewServicePairing = Effect.fn("homebrewServiceRecovery.deliver")(
+  function* (input: {
+    readonly expectedOwner: VerifiedOwner;
+    readonly pairingLink: string;
+    readonly inspect: () => Effect.Effect<HomebrewServiceInspection>;
+    readonly deliver: (link: string) => Effect.Effect<void>;
+  }) {
+    const current = yield* input.inspect();
+    if (current._tag !== "verified" || !current.pairingCompatible || current.unit !== input.expectedOwner.unit || current.fingerprint !== input.expectedOwner.fingerprint) return false;
+    yield* input.deliver(input.pairingLink);
+    return true;
+  },
+);
