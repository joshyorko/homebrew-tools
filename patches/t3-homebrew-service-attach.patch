@@ -0,0 +1,54 @@
+import { assert, describe, it } from "@effect/vitest";
+
+import * as HomebrewServiceOwnership from "./HomebrewServiceOwnership.ts";
+
+const knownOwner: HomebrewServiceOwnership.HomebrewServiceOwnerEvidence = {
+  unit: "t3code-homebrew.service",
+  activeState: "active",
+  mainPid: "412",
+  execStart:
+    "{ path=/home/linuxbrew/.linuxbrew/opt/t3code-cli-main/bin/t3 ; argv[]=/home/linuxbrew/.linuxbrew/opt/t3code-cli-main/bin/t3 serve ; ignore_errors=no ; }",
+  serviceT3Home: "/home/alice/.t3",
+  processUid: 1000,
+  currentUid: 1000,
+  runtimePid: 412,
+  t3Home: "/home/alice/.t3",
+  environmentId: "env-existing",
+  serverEnvironmentId: "env-existing",
+};
+
+describe("HomebrewServiceOwnership", () => {
+  it("recognizes an active same-user Homebrew service for the verified environment", () => {
+    assert.deepEqual(HomebrewServiceOwnership.classifyHomebrewServiceOwner(knownOwner), {
+      _tag: "verified",
+      unit: "t3code-homebrew.service",
+      environmentId: "env-existing",
+    });
+  });
+
+  it("keeps unknown, foreign, mismatched, or stale owners unverified", () => {
+    const mismatches: Partial<HomebrewServiceOwnership.HomebrewServiceOwnerEvidence>[] = [
+      { unit: "t3code.service" },
+      { processUid: 2000 },
+      { mainPid: "99" },
+      { execStart: knownOwner.execStart.replace("t3code-cli-main", "other-cli") },
+      { serviceT3Home: "/home/alice/other" },
+      { t3Home: "/home/alice/other" },
+      { serverEnvironmentId: "env-other" },
+    ];
+
+    for (const mismatch of mismatches) {
+      assert.deepEqual(
+        HomebrewServiceOwnership.classifyHomebrewServiceOwner({ ...knownOwner, ...mismatch }),
+        { _tag: "unverified" },
+      );
+    }
+  });
+
+  it("distinguishes an inactive known Homebrew unit from an unknown owner", () => {
+    assert.deepEqual(
+      HomebrewServiceOwnership.classifyHomebrewServiceOwner({ ...knownOwner, activeState: "inactive" }),
+      { _tag: "inactive", unit: knownOwner.unit },
+    );
+  });
+});
diff --git a/apps/desktop/src/backend/HomebrewServiceOwnership.ts b/apps/desktop/src/backend/HomebrewServiceOwnership.ts
new file mode 100644
index 00000000..93c84a1d
--- /dev/null
+++ b/apps/desktop/src/backend/HomebrewServiceOwnership.ts
@@ -0,0 +1,69 @@
+export const HOMEBREW_T3_SERVICE_UNITS = [
+  "sh.brew.t3code-cli-main.service",
+  "t3code-homebrew.service",
+] as const;
+
+export interface HomebrewServiceOwnerEvidence {
+  readonly unit: string;
+  readonly activeState: string;
+  readonly mainPid: string;
+  readonly execStart: string;
+  readonly serviceT3Home: string | null;
+  readonly processUid: number | null;
+  readonly currentUid: number;
+  readonly runtimePid: number;
+  readonly t3Home: string;
+  readonly environmentId: string;
+  readonly serverEnvironmentId: string;
+}
+
+export type HomebrewServiceOwnerClassification =
+  | { readonly _tag: "verified"; readonly unit: string; readonly environmentId: string }
+  | { readonly _tag: "inactive"; readonly unit: string }
+  | { readonly _tag: "unverified" };
+
+const homebrewServeCommand = (value: string): boolean => {
+  const path = value.match(/(?:^|[ {])path=([^ ;]+)/u)?.[1];
+  const argv = value.match(/argv\[\]=([^;]+)/u)?.[1]?.trim().split(/\s+/u);
+  return (
+    path !== undefined &&
+    argv !== undefined &&
+    argv[0] === path &&
+    path.endsWith("/opt/t3code-cli-main/bin/t3") &&
+    argv[1] === "serve" &&
+    argv.length === 2
+  );
+};
+
+export const homeDirectoryFromSystemdEnvironment = (value: string): string | null => {
+  const match = value.match(/(?:^|[=\s])T3CODE_HOME=(?:"([^"]+)"|([^\s]+))/u);
+  return match?.[1] ?? match?.[2] ?? null;
+};
+
+export function classifyHomebrewServiceOwner(
+  evidence: HomebrewServiceOwnerEvidence,
+): HomebrewServiceOwnerClassification {
+  if (!HOMEBREW_T3_SERVICE_UNITS.some((unit) => unit === evidence.unit)) {
+    return { _tag: "unverified" };
+  }
+  if (evidence.activeState !== "active") {
+    return { _tag: "inactive", unit: evidence.unit };
+  }
+  if (
+    evidence.processUid === null ||
+    evidence.processUid !== evidence.currentUid ||
+    !/^\d+$/u.test(evidence.mainPid) ||
+    Number(evidence.mainPid) !== evidence.runtimePid ||
+    !homebrewServeCommand(evidence.execStart) ||
+    evidence.serviceT3Home !== evidence.t3Home ||
+    evidence.environmentId.length === 0 ||
+    evidence.serverEnvironmentId !== evidence.environmentId
+  ) {
+    return { _tag: "unverified" };
+  }
+  return {
+    _tag: "verified",
+    unit: evidence.unit,
+    environmentId: evidence.environmentId,
+  };
+}
