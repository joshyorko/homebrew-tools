+// @effect-diagnostics nodeBuiltinImport:off -- Backup assertions exercise actual private Desktop settings files.
+import { mkdtemp, writeFile, readFile, stat, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { backupDesktopSettingsFile } from "./HomebrewServiceOwnerProbe.ts";
+import { assert, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import { prepareHomebrewServiceRecovery, deliverHomebrewServicePairing, type HomebrewServiceInspection } from "./HomebrewServiceRecovery.ts";
+
+const owner = { _tag: "verified", unit: "t3code-homebrew.service", environmentId: "existing-env", origin: "http://127.0.0.1:3773/", fingerprint: "original-process-and-lock", pairingCompatible: true } satisfies HomebrewServiceInspection;
+
+it.effect("invokes discovery and binds an approved pairing to the unchanged owner", () => Effect.gen(function* () {
+  let inspections = 0;
+  const paired: string[] = [];
+  const result = yield* prepareHomebrewServiceRecovery({
+    inspect: () => Effect.sync(() => { inspections++; return owner; }),
+    choose: () => Effect.succeed(0),
+    pair: (fingerprint) => Effect.sync(() => { paired.push(fingerprint); return "t3code://pair?fixture"; }),
+  });
+  assert.equal(inspections, 3);
+  assert.deepEqual(paired, [owner.fingerprint]);
+  assert.deepEqual(result, { _tag: "open", pairingLink: "t3code://pair?fixture", pairingRequested: true, expectedOwner: owner });
+}));
+
+it.effect.each([2, 3])("refuses an owner change at inspection %s", (changeAt) => Effect.gen(function* () {
+  let inspections = 0;
+  let pairCount = 0;
+  const result = yield* prepareHomebrewServiceRecovery({
+    inspect: () => Effect.sync(() => (++inspections === changeAt ? { ...owner, fingerprint: "replacement-process" } : owner)),
+    choose: () => Effect.succeed(0),
+    pair: () => Effect.sync(() => { pairCount++; return "t3code://pair?fixture"; }),
+  });
+  assert.deepEqual(result, { _tag: "open", pairingLink: null, pairingRequested: true, expectedOwner: owner });
+  assert.equal(pairCount, changeAt === 2 ? 0 : 1);
+}));
+
+it.effect("never mints a credential when the user cancels or the owner is unknown", () => Effect.gen(function* () {
