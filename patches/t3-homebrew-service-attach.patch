diff --git a/apps/desktop/src/backend/HomebrewServiceOwnerProbe.ts b/apps/desktop/src/backend/HomebrewServiceOwnerProbe.ts
new file mode 100644
index 00000000..9176a327
--- /dev/null
+++ b/apps/desktop/src/backend/HomebrewServiceOwnerProbe.ts
@@ -0,0 +1,218 @@
+// @effect-diagnostics nodeBuiltinImport:off -- `/proc/<pid>` ownership identifies the locked state owner on Linux.
+import { stat } from "node:fs/promises";
+import * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+import * as Stream from "effect/Stream";
+import { HttpClient, HttpClientRequest, HttpClientResponse } from "effect/http";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+
+import { ExecutionEnvironmentDescriptor } from "@t3tools/contracts";
+import * as HostProcess from "@t3tools/shared/HostProcess";
+
+import * as DesktopEnvironment from "../app/DesktopEnvironment.ts";
+import * as HomebrewServiceOwnership from "./HomebrewServiceOwnership.ts";
+
+const PersistedServerRuntimeState = Schema.Struct({
+  version: Schema.Literal(1),
+  pid: Schema.Int,
+  port: Schema.Int,
+  origin: Schema.String,
+});
+
+const parseProperties = (raw: string): Readonly<Record<string, string>> =>
+  Object.fromEntries(
+    raw
+      .split(/\r?\n/u)
+      .flatMap((line) => {
+        const separator = line.indexOf("=");
+        return separator < 0 ? [] : [[line.slice(0, separator), line.slice(separator + 1)]];
+      }),
+  );
+
+const runSystemdShow = (unit: string) =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
+      const handle = yield* spawner.spawn(
+        ChildProcess.make(
+          "systemctl",
+          ["--user", "show", unit, "--property=ActiveState,MainPID,ExecStart,Environment"],
+          { stdin: "ignore", stderr: "ignore", stdout: "pipe", forceKillAfter: "1 second" },
+        ),
+      );
+      const [stdout, exitCode] = yield* Effect.all(
+        [handle.stdout.pipe(Stream.decodeText(), Stream.mkString), handle.exitCode],
+        { concurrency: "unbounded" },
+      ).pipe(Effect.timeout(Duration.seconds(3)));
+      return exitCode === 0 ? parseProperties(stdout) : null;
+    }),
+  ).pipe(Effect.orElseSucceed(() => null));
+
+const readDescriptor = (url: URL) =>
+  Effect.gen(function* () {
+    const client = yield* HttpClient.HttpClient;
+    const response = yield* client
+      .execute(HttpClientRequest.get(new URL("/.well-known/t3/environment", url).href))
+      .pipe(Effect.timeout(Duration.seconds(2)), Effect.orElseSucceed(() => null));
+    if (response === null || response.status !== 200) return null;
+    return yield* HttpClientResponse.schemaBodyJson(ExecutionEnvironmentDescriptor)(response).pipe(
+      Effect.orElseSucceed(() => null),
+    );
+  });
+
+const currentProcessUid = (pid: string) =>
+  Effect.tryPromise({
+    try: () => stat(`/proc/${pid}`).then((info) => info.uid),
+    catch: () => null,
+  }).pipe(Effect.orElseSucceed(() => null));
+
+export const inspectHomebrewServiceOwner = Effect.fn("homebrewServiceOwnership.inspect")(
+  function* () {
+    const environment = yield* DesktopEnvironment.DesktopEnvironment;
+    const fileSystem = yield* FileSystem.FileSystem;
+    const userId = yield* HostProcess.UserId;
+    if (environment.platform !== "linux" || userId === undefined) {
+      return { _tag: "unverified" } as const;
+    }
+
+    const runtimeRaw = yield* fileSystem
+      .readFileString(environment.path.join(environment.stateDir, "server-runtime.json"))
+      .pipe(Effect.orElseSucceed(() => null));
+    const idRaw = yield* fileSystem
+      .readFileString(environment.path.join(environment.stateDir, "environment-id"))
+      .pipe(Effect.orElseSucceed(() => null));
+    if (runtimeRaw === null || idRaw === null) return { _tag: "unverified" } as const;
+
+    let parsedRuntime: unknown;
+    try {
+      parsedRuntime = JSON.parse(runtimeRaw);
+    } catch {
+      return { _tag: "unverified" } as const;
+    }
+    const runtime = Schema.decodeUnknownOption(PersistedServerRuntimeState)(parsedRuntime);
+    if (Option.isNone(runtime)) return { _tag: "unverified" } as const;
+    if (runtime.value.pid < 1 || runtime.value.port < 1 || runtime.value.port > 65_535) {
+      return { _tag: "unverified" } as const;
+    }
+
+    let origin: URL;
+    try {
+      origin = new URL(runtime.value.origin);
+    } catch {
+      return { _tag: "unverified" } as const;
+    }
+    if (
+      origin.protocol !== "http:" ||
+      !["127.0.0.1", "localhost", "::1", "[::1]"].includes(origin.hostname) ||
+      Number(origin.port || "80") !== runtime.value.port
+    ) {
+      return { _tag: "unverified" } as const;
+    }
+
+    const environmentId = idRaw.trim();
+    if (!environmentId) return { _tag: "unverified" } as const;
+    const descriptor = yield* readDescriptor(origin);
+    if (descriptor === null) return { _tag: "unverified" } as const;
+
+    const homebrewHome = yield* fileSystem
+      .realPath(environment.baseDir)
+      .pipe(Effect.orElseSucceed(() => null));
+    if (homebrewHome === null) return { _tag: "unverified" } as const;
+
+    let sawActiveUnit = false;
+    let inactiveUnit: string | null = null;
+    for (const unit of HomebrewServiceOwnership.HOMEBREW_T3_SERVICE_UNITS) {
+      const properties = yield* runSystemdShow(unit);
+      if (properties === null) continue;
+      const mainPid = properties.MainPID ?? "";
+      const activeState = properties.ActiveState ?? "";
+      sawActiveUnit ||= activeState === "active";
+      if (activeState !== "active") {
+        inactiveUnit ??= unit;
+        continue;
+      }
+      const configuredHome = HomebrewServiceOwnership.homeDirectoryFromSystemdEnvironment(
+        properties.Environment ?? "",
+      );
+      const serviceT3Home =
+        configuredHome === null
+          ? null
+          : yield* fileSystem.realPath(configuredHome).pipe(Effect.orElseSucceed(() => null));
+      const processUid = /^\d+$/u.test(mainPid) ? yield* currentProcessUid(mainPid) : null;
+      const classification = HomebrewServiceOwnership.classifyHomebrewServiceOwner({
+        unit,
+        activeState,
+        mainPid,
+        execStart: properties.ExecStart ?? "",
+        serviceT3Home,
+        processUid,
+        currentUid: userId,
+        runtimePid: runtime.value.pid,
+        t3Home: homebrewHome,
+        environmentId,
+        serverEnvironmentId: descriptor.environmentId,
+      });
+      if (classification._tag === "verified") {
+        return { ...classification, origin: origin.href } as const;
+      }
+    }
+    if (!sawActiveUnit && inactiveUnit !== null) {
+      return { _tag: "inactive", unit: inactiveUnit } as const;
+    }
+    return { _tag: "unverified" } as const;
+  },
+);
+
+export const createHomebrewServicePairingAppLink = Effect.fn(
+  "homebrewServiceOwnership.createPairingAppLink",
+)(function* () {
+  const environment = yield* DesktopEnvironment.DesktopEnvironment;
+  const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
+  const result = yield* Effect.scoped(
+    Effect.gen(function* () {
+      const handle = yield* spawner.spawn(
+        ChildProcess.make(
+          process.execPath,
+          [
+            environment.backendEntryPath,
+            "pair",
+            "--base-dir",
+            environment.baseDir,
+            "--label",
+            "Homebrew T3 Desktop",
+          ],
+          {
+            env: {
+              ELECTRON_RUN_AS_NODE: "1",
+              T3CODE_HOME: environment.baseDir,
+              T3CODE_TELEMETRY_ENABLED: "false",
+            },
+            extendEnv: true,
+            stdin: "ignore",
+            stderr: "ignore",
+            stdout: "pipe",
+            forceKillAfter: "1 second",
+          },
+        ),
+      );
+      const [stdout, exitCode] = yield* Effect.all(
+        [handle.stdout.pipe(Stream.decodeText(), Stream.mkString), handle.exitCode],
+        { concurrency: "unbounded" },
+      ).pipe(Effect.timeout(Duration.seconds(10)));
+      return exitCode === 0 ? stdout : null;
+    }),
+  ).pipe(Effect.orElseSucceed(() => null));
+  if (result === null) return null;
+
+  const appLink = result.match(/^App link:\s+(t3code:\/\/pair\?[^\s]+)$/mu)?.[1];
+  if (appLink === undefined) return null;
+  try {
+    const parsed = new URL(appLink);
+    return parsed.protocol === "t3code:" && parsed.hostname === "pair" ? appLink : null;
+  } catch {
+    return null;
+  }
+});
diff --git a/apps/desktop/src/backend/HomebrewServiceOwnership.test.ts b/apps/desktop/src/backend/HomebrewServiceOwnership.test.ts
