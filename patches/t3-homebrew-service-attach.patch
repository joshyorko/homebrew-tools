@@ -0,0 +1,69 @@
+// @effect-diagnostics nodeBuiltinImport:off -- Tests exercise real Linux SQLite locks and listener ownership.
+import { DatabaseSync } from "node:sqlite";
+import { createServer } from "node:http";
+import { mkdtemp, writeFile, rm, mkdir } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { assert, it } from "@effect/vitest";
+import { readHomebrewServerOwner, ownsSqliteLock, homebrewPackageFromEntry, readHomebrewDesktopPackage } from "./homebrewServerOwner.ts";
+
+it("requires the actual SQLite lock holder and its live listener, not stale metadata", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "t3-homebrew-owner-"));
+  const server = createServer((_request, response) => response.end("fixture"));
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address();
+  assert.isNotNull(address);
+  if (address === null || typeof address === "string") throw new Error("Expected TCP listener");
+  const db = new DatabaseSync(join(dir, "server-owner.sqlite"));
+  const runtime = { pid: process.pid, ownerId: "original-owner", origin: `http://127.0.0.1:${address.port}` };
+  try {
+    db.exec("BEGIN EXCLUSIVE");
+    await writeFile(join(dir, "server-runtime.json"), JSON.stringify(runtime));
+    await writeFile(join(dir, "environment-id"), "existing-environment");
+    const original = await readHomebrewServerOwner(dir);
+    assert.isNotNull(original);
+    await writeFile(join(dir, "server-runtime.json"), JSON.stringify({ ...runtime, ownerId: "replacement-owner" }));
+    assert.notEqual((await readHomebrewServerOwner(dir))?.fingerprint, original?.fingerprint);
+    await writeFile(join(dir, "server-runtime.json"), JSON.stringify({ ...runtime, pid: process.pid + 1 }));
+    assert.isNull(await readHomebrewServerOwner(dir));
+    await writeFile(join(dir, "server-runtime.json"), JSON.stringify(runtime));
+    db.exec("ROLLBACK");
+    assert.isNull(await readHomebrewServerOwner(dir));
+  } finally {
+    db.close();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+    await rm(dir, { recursive: true, force: true });
+  }
+});
+
+it("refuses blocked requests, foreign PIDs, and locks on another inode", () => {
+  const line = "1: POSIX ADVISORY WRITE 42 00:20:100 1073741824 1073742335";
+  assert.isTrue(ownsSqliteLock({ locks: line, pid: 42, device: 32n, inode: 100n }));
+  assert.isFalse(ownsSqliteLock({ locks: line, pid: 43, device: 32n, inode: 100n }));
+  assert.isFalse(ownsSqliteLock({ locks: line, pid: 42, device: 32n, inode: 101n }));
+  assert.isFalse(ownsSqliteLock({ locks: line.replace(": POSIX", ": -> POSIX"), pid: 42, device: 32n, inode: 100n }));
+});
+
+it("requires the exact immutable package and expected Homebrew receipt source", async () => {
+  const dir = await mkdtemp(join(tmpdir(), "t3-homebrew-package-"));
+  const version = "main.20261107124307.e455200077ce";
+  const keg = join(dir, "Cellar", "t3code-cli-main", version);
+  const entry = join(keg, "libexec", "dist", "bin.mjs");
+  const resources = join(dir, "resources");
+  try {
+    await mkdir(join(keg, "libexec", "dist"), { recursive: true });
+    await mkdir(resources);
+    await writeFile(entry, "export {};\n");
+    assert.isNull(await homebrewPackageFromEntry(entry));
+    await writeFile(join(keg, "INSTALL_RECEIPT.json"), JSON.stringify({ source: { tap: "foreign/tools" } }));
+    assert.isNull(await homebrewPackageFromEntry(entry));
+    await writeFile(join(keg, "INSTALL_RECEIPT.json"), JSON.stringify({ source: { tap: "joshyorko/tools" } }));
+    assert.equal(await homebrewPackageFromEntry(entry), version);
+    assert.isNull(await homebrewPackageFromEntry(join(dir, "unknown-bin.mjs")));
+    assert.isNull(await readHomebrewDesktopPackage(resources));
+    await writeFile(join(resources, "t3-homebrew-build.json"), JSON.stringify({ packageVersion: version, sourceCommit: "f".repeat(40) }));
+    assert.isNull(await readHomebrewDesktopPackage(resources));
+    await writeFile(join(resources, "t3-homebrew-build.json"), JSON.stringify({ packageVersion: version, sourceCommit: "e455200077ce60806a01c8f28435b58860dcfc74" }));
+    assert.equal(await readHomebrewDesktopPackage(resources), version);
+  } finally { await rm(dir, { recursive: true, force: true }); }
+});
diff --git a/packages/shared/src/homebrewServerOwner.ts b/packages/shared/src/homebrewServerOwner.ts
new file mode 100644
index 00000000..f92d7f06
--- /dev/null
+++ b/packages/shared/src/homebrewServerOwner.ts
@@ -0,0 +1,113 @@
+// @effect-diagnostics nodeBuiltinImport:off -- Linux kernel lock and process identities are the trust boundary.
+import { readFile, lstat, stat, readdir, readlink, realpath } from "node:fs/promises";
+import { join, dirname } from "node:path";
+
+const processStart = async (pid: number): Promise<string | null> => {
+  const value = await readFile(`/proc/${pid}/stat`, "utf8");
+  return value.slice(value.lastIndexOf(")") + 2).split(/\s+/u)[19] ?? null;
+};
+
+export function ownsSqliteLock(input: {
+  readonly locks: string;
+  readonly pid: number;
+  readonly device: bigint;
+  readonly inode: bigint;
+}): boolean {
+  const major = ((input.device >> 8n) & 0xfffn) | ((input.device >> 32n) & 0xfffff000n);
+  const minor = (input.device & 0xffn) | ((input.device >> 12n) & 0xffffff00n);
+  return input.locks.split("\n").some((line) => {
+    const match = line.match(/^\d+:\s+POSIX\s+ADVISORY\s+WRITE\s+(\d+)\s+([\da-f]+):([\da-f]+):(\d+)\s+(\d+)\s+(\d+|EOF)$/iu);
+    return match !== null &&
+      Number(match[1]) === input.pid &&
+      BigInt(`0x${match[2]}`) === major && BigInt(`0x${match[3]}`) === minor &&
+      BigInt(match[4] ?? "-1") === input.inode &&
+      Number(match[5]) <= 1_073_741_824 &&
+      (match[6] === "EOF" || Number(match[6]) >= 1_073_742_335);
+  });
+}
+
+const listenerOwnedBy = async (pid: number, origin: string): Promise<boolean> => {
+  const url = new URL(origin);
+  if (url.protocol !== "http:" || !["127.0.0.1", "localhost", "[::1]"].includes(url.hostname)) return false;
+  const port = Number(url.port || "80");
+  const tables = await Promise.all(["tcp", "tcp6"].map((name) => readFile(`/proc/${pid}/net/${name}`, "utf8")));
+  const listeners = new Set(tables.flatMap((table) => table.split("\n").flatMap((line) => {
+    const fields = line.trim().split(/\s+/u);
+    return fields[3] === "0A" && Number.parseInt(fields[1]?.split(":")[1] ?? "", 16) === port
+      ? [fields[9]] : [];
+  })));
+  const sockets = await Promise.all((await readdir(`/proc/${pid}/fd`)).map((fd) =>
+    readlink(`/proc/${pid}/fd/${fd}`).catch(() => ""),
+  ));
+  return sockets.some((socket) => listeners.has(socket.match(/^socket:\[(\d+)\]$/u)?.[1]));
+};
+
+const packageVersionPattern = /^main\.\d{14}\.[0-9a-f]{12}$/u;
+
+export async function readHomebrewDesktopPackage(resourcesPath: string): Promise<string | null> {
+  try {
+    const value: unknown = JSON.parse(await readFile(join(resourcesPath, "t3-homebrew-build.json"), "utf8"));
+    if (typeof value !== "object" || value === null ||
+      !("packageVersion" in value) || typeof value.packageVersion !== "string" || !packageVersionPattern.test(value.packageVersion) ||
+      !("sourceCommit" in value) || typeof value.sourceCommit !== "string" || !/^[0-9a-f]{40}$/u.test(value.sourceCommit) ||
+      !value.packageVersion.endsWith("." + value.sourceCommit.slice(0, 12))) return null;
+    return value.packageVersion;
+  } catch { return null; }
+}
+
+export async function homebrewPackageFromEntry(entry: string): Promise<string | null> {
+  const raw = entry.match(/^(.*\/Cellar\/t3code-cli-main\/)([^/]+)\/libexec\/dist\/(?:bin|index)\.mjs$/u);
+  if (raw === null || !packageVersionPattern.test(raw[2] ?? "")) return null;
+  try {
+    const canonical = await realpath(entry);
+    const actual = canonical.match(/^(.*\/Cellar\/t3code-cli-main\/)([^/]+)\/libexec\/dist\/(?:bin|index)\.mjs$/u);
+    if (actual === null || actual[2] !== raw[2]) return null;
+    const receipt: unknown = JSON.parse(await readFile(join(dirname(dirname(dirname(canonical))), "INSTALL_RECEIPT.json"), "utf8"));
+    if (typeof receipt !== "object" || receipt === null || !("source" in receipt) ||
+      typeof receipt.source !== "object" || receipt.source === null || !("tap" in receipt.source) || receipt.source.tap !== "joshyorko/tools") return null;
+    return actual[2] ?? null;
+  } catch { return null; }
+}
+
+const processPackage = async (pid: number): Promise<string | null> => {
+  const args = (await readFile(`/proc/${pid}/cmdline`, "utf8")).split("\0");
+  for (const arg of args) {
+    const version = await homebrewPackageFromEntry(arg);
+    if (version !== null) return version;
+  }
+  return null;
+};
+
+export async function readHomebrewServerOwner(stateDir: string) {
+  if (process.platform !== "linux" || !process.getuid) return null;
+  try {
+    const runtimePath = join(stateDir, "server-runtime.json");
+    const runtimeRaw = await readFile(runtimePath, "utf8");
+    const runtime: unknown = JSON.parse(runtimeRaw);
+    if (typeof runtime !== "object" || runtime === null ||
+      !("pid" in runtime) || typeof runtime.pid !== "number" || !Number.isSafeInteger(runtime.pid) || runtime.pid < 1 ||
+      !("ownerId" in runtime) || typeof runtime.ownerId !== "string" || !runtime.ownerId ||
+      !("origin" in runtime) || typeof runtime.origin !== "string") return null;
+    const lockPath = join(stateDir, "server-owner.sqlite");
+    const before = await lstat(lockPath, { bigint: true });
+    const processInfo = await stat(`/proc/${runtime.pid}`);
+    if (!before.isFile() || before.isSymbolicLink() || before.uid !== BigInt(process.getuid()) || processInfo.uid !== process.getuid()) return null;
+    const start = await processStart(runtime.pid);
+    if (!await listenerOwnedBy(runtime.pid, runtime.origin)) return null;
+    if (start === null || !ownsSqliteLock({
+      locks: await readFile("/proc/locks", "utf8"), pid: runtime.pid, device: before.dev, inode: before.ino,
+    })) return null;
+    const environmentId = (await readFile(join(stateDir, "environment-id"), "utf8")).trim();
+    const after = await lstat(lockPath, { bigint: true });
+    if (!environmentId || before.dev !== after.dev || before.ino !== after.ino ||
+      start !== await processStart(runtime.pid) || runtimeRaw !== await readFile(runtimePath, "utf8")) return null;
+    const packageVersion = await processPackage(runtime.pid);
+    const fingerprint = JSON.stringify({
+      pid: runtime.pid, start, device: before.dev.toString(), inode: before.ino.toString(),
+      ownerId: runtime.ownerId, environmentId, origin: runtime.origin, packageVersion,
+    });
