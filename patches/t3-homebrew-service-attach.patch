diff --git a/apps/desktop/src/backend/HomebrewServiceAttachment.ts b/apps/desktop/src/backend/HomebrewServiceAttachment.ts
new file mode 100644
index 0000000..9891f30
--- /dev/null
+++ b/apps/desktop/src/backend/HomebrewServiceAttachment.ts
@@ -0,0 +1,106 @@
+import * as Cause from "effect/Cause";
+import * as Effect from "effect/Effect";
+import * as Electron from "electron";
+import * as DesktopEnvironment from "../app/DesktopEnvironment.ts";
+import * as DesktopObservability from "../app/DesktopObservability.ts";
+import * as DesktopAppSettings from "../settings/DesktopAppSettings.ts";
+import * as DesktopWindow from "../window/DesktopWindow.ts";
+import * as ElectronApp from "../electron/ElectronApp.ts";
+import * as ElectronDialog from "../electron/ElectronDialog.ts";
+import { getDesktopUrl } from "../electron/ElectronProtocol.ts";
+import * as HomebrewServiceOwnerProbe from "./HomebrewServiceOwnerProbe.ts";
+import {
+  prepareHomebrewServiceRecovery,
+  deliverHomebrewServicePairing,
+} from "./HomebrewServiceRecovery.ts";
+
+const { logWarning } = DesktopObservability.makeComponentLogger("desktop-homebrew-service");
+
+export const recover = Effect.gen(function* () {
+  const electronDialog = yield* ElectronDialog.ElectronDialog;
+  const electronApp = yield* ElectronApp.ElectronApp;
+  const appSettings = yield* DesktopAppSettings.DesktopAppSettings;
+  const desktopWindow = yield* DesktopWindow.DesktopWindow;
+  const probeContext = yield* Effect.context<
+    | Effect.Services<ReturnType<typeof HomebrewServiceOwnerProbe.inspectHomebrewServiceOwner>>
+    | Effect.Services<
+        ReturnType<typeof HomebrewServiceOwnerProbe.createHomebrewServicePairingAppLink>
+      >
+  >();
+  const inspect = () =>
+    HomebrewServiceOwnerProbe.inspectHomebrewServiceOwner().pipe(Effect.provide(probeContext));
+  const recovery = yield* prepareHomebrewServiceRecovery({
+    inspect,
+    pair: (expected) =>
+      HomebrewServiceOwnerProbe.createHomebrewServicePairingAppLink(expected).pipe(
+        Effect.provide(probeContext),
+      ),
+    choose: (owner) =>
+      electronDialog
+        .showMessageBox({
+          type: "warning",
+          title: "Homebrew T3 service is already running",
+          message: `Connect this Desktop to ${owner.unit}?`,
+          detail: `The running service was verified for T3 environment ${owner.environmentId}. Connecting turns off Desktop's local environment and asks you to confirm pairing with ${owner.origin}. The service keeps running when Desktop closes.`,
+          buttons: ["Connect to running service", "Open pairing settings", "Quit"],
+          defaultId: 0,
+          cancelId: 2,
+        })
+        .pipe(Effect.map((choice) => choice.response)),
+  });
+  if (recovery._tag === "quit") return yield* electronApp.quit;
+  if (recovery._tag === "open") {
+    yield* HomebrewServiceOwnerProbe.backupHomebrewDesktopSettings();
+    yield* appSettings.setLocalEnvironmentEnabled(false);
+    yield* desktopWindow.createMainIfBackendReady;
+    const environment = yield* DesktopEnvironment.DesktopEnvironment;
+    const window = yield* desktopWindow.ensureMain;
+    // The renderer reads localEnvironmentEnabled only when it boots.
+    const desktopUrl = getDesktopUrl(environment.isDevelopment);
+    const connectionsUrl = new URL("/settings/connections", desktopUrl).href;
+    yield* Effect.promise(() =>
+      window.loadURL(recovery.pairingLink === null ? connectionsUrl : desktopUrl),
+    );
+    let delivered = false;
+    if (recovery.pairingLink !== null && recovery.expectedOwner !== null) {
+      delivered = yield* deliverHomebrewServicePairing({
+        expectedOwner: recovery.expectedOwner,
+        pairingLink: recovery.pairingLink,
+        inspect,
+        deliver: (link) =>
+          Effect.sync(() => {
+            Electron.app.emit("open-url", { preventDefault() {} }, link);
+          }),
+      });
+    }
+    if (!delivered && recovery.pairingRequested) {
+      yield* Effect.promise(() => window.loadURL(connectionsUrl));
+      yield* electronDialog.showErrorBox(
+        "Could not create a pairing link",
+        "Desktop is open with its local environment off. The server changed or could not be paired; add it from Settings > Connections after verifying it.",
+      );
+    }
+    return;
+  }
+
+  const detail =
+    recovery._tag === "inactive"
+      ? `The Homebrew unit ${recovery.unit} is inactive while another process still owns this T3 home. Check it with systemctl --user status ${recovery.unit}. No service was stopped and no data was changed.`
+      : "Another process owns this T3 home, but T3 could not verify it as the same-user Homebrew service or confirm its environment identity. Inspect the owner before reconnecting. No service was stopped and no data was changed.";
+  yield* electronDialog.showErrorBox("T3 home owner could not be verified", detail);
+  yield* electronApp.quit;
+}).pipe(
+  Effect.catchCause((cause) =>
+    Effect.gen(function* () {
+      yield* logWarning("failed to recover from T3 home ownership conflict", {
+        cause: Cause.pretty(cause),
+      });
+      yield* (yield* ElectronDialog.ElectronDialog).showErrorBox(
+        "T3 home owner could not be verified",
+        "Recovery could not complete. The existing service was not stopped. Review the Desktop logs before retrying.",
+      );
+      yield* (yield* ElectronApp.ElectronApp).quit;
+    }),
+  ),
+  Effect.withSpan("desktop.homebrewServiceAttachment"),
+);
