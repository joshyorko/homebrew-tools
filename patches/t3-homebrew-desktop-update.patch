index 0000000000000000000000000000000000000000..7b5286d39c24213512ab581cdb8f5a2d5079cf0d
--- /dev/null
+++ b/apps/desktop/src/updates/HomebrewDesktopUpdates.test.ts
@@ -0,0 +1,114 @@
+import { assert, describe, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import { rejects } from "node:assert/strict";
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- Provider tests verify real subprocess files and permissions.
+import { chmod, mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- Test paths are passed to a native helper process.
+import { join } from "node:path";
+
+import { createHomebrewDesktopUpdates, parseHomebrewBuildIdentity } from "./HomebrewDesktopUpdates.ts";
+
+const version = "main.20261106111159.6577c6b61851";
+const nextVersion = "main.20261107111159.abcdef123456";
+const updateFields = `"currentVersion":"${version}","availableVersion":"${nextVersion}","source":"joshyorko/tools","sourceCommit":"abcdef123456","formula":"${nextVersion}","cask":"${nextVersion}"`;
+
+describe("HomebrewDesktopUpdates", () => {
+  it("uses the embedded package identity independently of Electron semver", () => {
+    assert.equal(parseHomebrewBuildIdentity(JSON.stringify({ packageVersion: version, sourceCommit: "6577c6b6185167c0e502fa01f9e8e8f2dee6ff25" })), version);
+    assert.throws(() => parseHomebrewBuildIdentity(JSON.stringify({ packageVersion: version, sourceCommit: "0".repeat(40) })));
+  });
+
+  it.effect("passes fixed argv to check, prepare, and supervised apply", () =>
+    Effect.promise(async () => {
+      const root = await mkdtemp(join(tmpdir(), "t3-homebrew-provider-"));
+      try {
+        const helper = join(root, "t3-homebrew-update.sh");
+        const calls = join(root, "calls.jsonl");
+        await writeFile(
+          helper,
+          `#!/usr/bin/env node\nconst fs = require("node:fs")\nconst path = require("node:path")\nconst args = process.argv.slice(2)\nif (args[0] === "apply") { fs.writeFileSync(args[args.indexOf("--ready-file") + 1], "ready"); args.splice(args.indexOf("--ready-file"), 2); setTimeout(() => {}, 300); }\nfs.appendFileSync(path.join(process.env.HOME, "calls.jsonl"), JSON.stringify(args) + "\\n")\nif (args[0] === "check") process.stdout.write(JSON.stringify({ status: "available", ${updateFields} }))\nif (args[0] === "prepare") process.stdout.write(JSON.stringify({ status: "prepared", ${updateFields} }))\n`,
+          { mode: 0o755 },
+        );
+        await chmod(helper, 0o755);
+        const provider = createHomebrewDesktopUpdates({ helperPath: helper, stateHome: join(root, "state"), homeDirectory: root, runtimeDirectory: root });
+        const check = await provider.check(version);
+        const prepared = await provider.prepare(version, nextVersion);
+        assert.equal(prepared.formula, nextVersion);
+        assert.equal(prepared.cask, nextVersion);
+        await provider.apply(version, nextVersion, 1234);
+        assert.deepEqual(check, {
+          status: "available",
+          currentVersion: version,
+          availableVersion: nextVersion,
+          source: "joshyorko/tools",
+          sourceCommit: "abcdef123456",
+          formula: nextVersion,
+          cask: nextVersion,
+        });
+        for (let attempt = 0; attempt < 100; attempt++) {
+          if ((await readFile(calls, "utf8")).trim().split("\n").length === 3) break;
+          // @effect-diagnostics-next-line globalTimers:off -- Native child-process readiness is independent of the virtual Effect test clock.
+          await new Promise((resolve) => setTimeout(resolve, 10));
+        }
+        assert.deepEqual(
+          (await readFile(calls, "utf8")).trim().split("\n").map((line) => JSON.parse(line)),
+          [
+            ["check", "--json", "--app-version", version],
+            ["prepare", "--app-version", version, "--version", nextVersion],
+            ["apply", "--app-version", version, "--version", nextVersion, "--wait-for-pid", "1234"],
+          ],
+        );
+      } finally {
+        await rm(root, { recursive: true, force: true });
+      }
+    }),
+  );
+
+  it.effect("rejects unsafe package versions before invoking the helper", () =>
+    Effect.promise(async () => {
+      const root = await mkdtemp(join(tmpdir(), "t3-homebrew-provider-"));
+      try {
+        const helper = join(root, "t3-homebrew-update.sh");
+        const calls = join(root, "calls.jsonl");
+        await writeFile(
+          helper,
+          `#!/usr/bin/env node\nrequire("node:fs").appendFileSync(require("node:path").join(__dirname, "calls.jsonl"), "called\\n")\n`,
+          { mode: 0o755 },
+        );
+        const provider = createHomebrewDesktopUpdates({ helperPath: helper, stateHome: join(root, "state"), homeDirectory: root, runtimeDirectory: root });
+        await rejects(provider.prepare(version, "main.1; touch /tmp/should-not-run"));
+        await rejects(readFile(calls, "utf8"));
+      } finally {
+        await rm(root, { recursive: true, force: true });
+      }
+    }),
+  );
+
+  it.effect("consumes the helper's post-relaunch result exactly once", () =>
+    Effect.promise(async () => {
+      const root = await mkdtemp(join(tmpdir(), "t3-homebrew-provider-"));
+      try {
+        const stateHome = join(root, "state");
+        const resultPath = join(stateHome, "t3code", "homebrew-update", "result.json");
+        await mkdir(join(stateHome, "t3code", "homebrew-update"), { recursive: true });
+        await writeFile(resultPath, JSON.stringify({ outcome: "installed", version }));
+        const provider = createHomebrewDesktopUpdates({ helperPath: join(root, "unused"), stateHome, homeDirectory: root });
+        assert.deepEqual(await provider.takeResult(), { outcome: "installed", version });
+        assert.equal(await provider.takeResult(), undefined);
+      } finally {
+        await rm(root, { recursive: true, force: true });
+      }
+    }),
+  );
+  it.effect("refuses a child that fails before readiness so Desktop can remain open", () => Effect.promise(async () => {
+    const root = await mkdtemp(join(tmpdir(), "t3-homebrew-not-ready-"));
+    try {
+      const helper = join(root, "t3-homebrew-update.sh");
+      await writeFile(helper, "#!/bin/sh\nexit 1\n", { mode: 0o755 });
+      const provider = createHomebrewDesktopUpdates({ helperPath: helper, stateHome: root, homeDirectory: root, runtimeDirectory: root });
+      await rejects(provider.apply(version, nextVersion, process.pid), /before accepting/);
+    } finally { await rm(root, { recursive: true, force: true }); }
+  }));
+
+});
