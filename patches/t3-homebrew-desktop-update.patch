@@ -0,0 +1,495 @@
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- This Promise boundary supervises a detached native process beyond the Effect runtime lifetime.
+import { execFile, spawn } from "node:child_process";
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- Native promises stage private helper files used after Electron exits.
+import { chmod, copyFile, lstat, mkdtemp, readFile, rm, unlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- Validate native Linux runtime-directory paths at the detached-process boundary.
+import { isAbsolute, join } from "node:path";
+import type { DesktopUpdateState } from "@t3tools/contracts";
+import * as Schema from "effect/Schema";
+import * as updateMachine from "./updateMachine.ts";
+import type { UpdatePolicy } from "./DesktopUpdatePolicy.ts";
+
+export class HomebrewDesktopUpdateError extends Schema.TaggedError<HomebrewDesktopUpdateError>()(
+  "HomebrewDesktopUpdateError",
+  { message: Schema.String, cause: Schema.Defect() },
+) {}
+
+export function homebrewStateHome(homeDirectory: string): string {
+  return process.env.XDG_STATE_HOME?.trim() || join(homeDirectory, ".local", "state");
+}
+
+const HomebrewUpdateCheckSchema = Schema.Struct({
+  status: Schema.Literals(["current", "available"]),
+  currentVersion: Schema.String,
+  availableVersion: Schema.String,
+  source: Schema.String,
+  sourceCommit: Schema.String,
+  formula: Schema.String,
+  cask: Schema.String,
+  message: Schema.optionalKey(Schema.String),
+});
+export type HomebrewUpdateCheck = typeof HomebrewUpdateCheckSchema.Type;
+
+const HomebrewUpdatePreparedSchema = Schema.Struct({
+  status: Schema.Literal("prepared"),
+  currentVersion: Schema.String,
+  availableVersion: Schema.String,
+  source: Schema.String,
+  sourceCommit: Schema.String,
+  formula: Schema.String,
+  cask: Schema.String,
+  message: Schema.optionalKey(Schema.String),
+});
+export type HomebrewUpdatePrepared = typeof HomebrewUpdatePreparedSchema.Type;
+
+const HomebrewUpdateResultSchema = Schema.Struct({
+  outcome: Schema.Literals(["installed", "failed"]),
+  version: Schema.String,
+  message: Schema.optionalKey(Schema.String),
+});
+export type HomebrewUpdateResult = typeof HomebrewUpdateResultSchema.Type;
+
+export type HomebrewUpdateMetadata = Pick<
+  HomebrewUpdateCheck,
+  "source" | "sourceCommit" | "formula" | "cask"
+> & { readonly installedVersion: string };
+
+export function isHomebrewManaged(input: {
+  readonly platform: NodeJS.Platform;
+  readonly isPackaged: boolean;
+  readonly mockUpdates: boolean;
+  readonly hasHelper: boolean;
+}): boolean {
+  return input.platform === "linux" && input.isPackaged && !input.mockUpdates && input.hasHelper;
+}
+
+export function homebrewDisabledReason(input: {
+  readonly policy: Pick<UpdatePolicy, "mode" | "message" | "feedUrl">;
+  readonly hasBuildIdentity: boolean;
+  readonly disabledByEnvironment: boolean;
+}): string | null {
+  if (input.policy.message !== null || input.policy.mode === "off" || input.policy.feedUrl !== undefined) {
+    return input.policy.message ?? "Your administrator manages T3 Code updates.";
+  }
+  if (!input.hasBuildIdentity) return "The packaged Homebrew build identity is missing or invalid.";
+  return input.disabledByEnvironment
+    ? "Automatic updates are disabled by the T3CODE_DISABLE_AUTO_UPDATE setting."
+    : null;
+}
+
+function metadataOfUpdate(result: HomebrewUpdateCheck | HomebrewUpdatePrepared): HomebrewUpdateMetadata {
+  return {
+    source: result.source,
+    sourceCommit: result.sourceCommit,
+    installedVersion: result.currentVersion,
+    formula: result.formula,
+    cask: result.cask,
+  };
+}
+
+export function stateAfterHomebrewCheck(input: {
+  readonly state: DesktopUpdateState;
+  readonly result: HomebrewUpdateCheck;
+  readonly packageVersion: string;
+  readonly checkedAt: string;
+}): { readonly state: DesktopUpdateState; readonly metadata: HomebrewUpdateMetadata } {
+  const { result, state } = input;
+  if (sourceVersionOfPackageVersion(result.currentVersion) !== input.packageVersion) {
+    throw new Error("Homebrew package version does not match this Desktop.");
+  }
+  if (result.status === "available" && result.availableVersion === result.currentVersion) {
+    throw new Error("Homebrew reported an unchanged version as available.");
+  }
+  if (result.status === "current" && result.availableVersion !== result.currentVersion) {
+    throw new Error("Homebrew reported mismatched current package versions.");
+  }
+  const next = result.status === "available"
+    ? updateMachine.reduceDesktopUpdateStateOnUpdateAvailable(state, result.availableVersion, input.checkedAt)
+    : updateMachine.reduceDesktopUpdateStateOnNoUpdate(state, input.checkedAt);
+  const metadata = metadataOfUpdate(result);
+  return {
+    state: { ...next, homebrewUpdate: metadata, ...(result.message === undefined ? {} : { message: result.message }) },
+    metadata,
+  };
+}
+
+export function stateAfterHomebrewPreparation(input: {
+  readonly state: DesktopUpdateState;
+  readonly prepared: HomebrewUpdatePrepared;
+  readonly packageVersion: string;
+  readonly expectedVersion: string;
+}): { readonly state: DesktopUpdateState; readonly metadata: HomebrewUpdateMetadata } {
+  const { prepared, state } = input;
+  if (
+    sourceVersionOfPackageVersion(prepared.currentVersion) !== input.packageVersion ||
+    prepared.availableVersion !== input.expectedVersion ||
+    prepared.formula !== input.expectedVersion ||
+    prepared.cask !== input.expectedVersion
+  ) {
+    throw new Error("Homebrew prepared packages that do not match the checked pair.");
+  }
+  const metadata = metadataOfUpdate(prepared);
+  const next = updateMachine.reduceDesktopUpdateStateOnDownloadComplete(state, input.expectedVersion);
+  return {
+    state: {
+      ...next,
+      downloadPercent: null,
+      homebrewUpdate: metadata,
+      ...(prepared.message === undefined ? {} : { message: prepared.message }),
+    },
+    metadata,
+  };
+}
+
+const VERSION = /^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$/;
+const RESULT_FILE = "t3code/homebrew-update/result.json";
+
+export function sourceVersionOfPackageVersion(value: string): string {
+  const sourceVersion = /^main\.\d{14}\.[a-f0-9]{12}(?:_[0-9]+)?$/i.exec(value)?.[0];
+  if (sourceVersion === undefined) {
+    throw new Error("Homebrew package version is not a recognized T3 build.");
+  }
+  return sourceVersion.replace(/_[0-9]+$/, "");
+}
+
+function checkedVersion(value: unknown): string {
+  if (typeof value !== "string" || !VERSION.test(value)) {
+    throw new Error("Homebrew update helper returned an invalid version.");
+  }
+  return value;
+}
+
+export function parseHomebrewBuildIdentity(raw: string): string {
+  const value: unknown = JSON.parse(raw);
+  if (typeof value !== "object" || value === null || !("packageVersion" in value) || !("sourceCommit" in value)) throw new Error("Missing Homebrew build identity.");
+  const version = checkedVersion(value.packageVersion);
+  if (typeof value.sourceCommit !== "string" || !/^[a-f0-9]{40}$/.test(value.sourceCommit)) throw new Error("Invalid Homebrew build source.");
+  assertVersionSource(version, value.sourceCommit.slice(0, 12));
+  return sourceVersionOfPackageVersion(version);
+}
+
+function safeMessage(value: string): string {
+  return value
+    .split(/[\r\n\0]/, 1)[0]
+    ?.trim()
+    .slice(0, 1024)
+    .replace(/\b(?:https?|file):\/\/[^\s"'<>]+/gi, "[redacted URL]")
+    .replace(/\b(?:Bearer|Basic)\s+[^\s,;]+/gi, "[redacted credential]") ?? "";
+}
+
+function optionalMessage(value: unknown): string | undefined {
+  if (value === undefined) return undefined;
+  if (typeof value !== "string") {
+    throw new Error("Homebrew update helper returned an invalid message.");
+  }
+  return safeMessage(value);
+}
+
+function parseCheck(raw: string): HomebrewUpdateCheck {
+  const result = Schema.decodeUnknownSync(HomebrewUpdateCheckSchema)(JSON.parse(raw));
+  const message = optionalMessage(result.message);
+  const availableVersion = checkedVersion(result.availableVersion);
+  const metadata = metadataOf(result, availableVersion);
+  assertVersionSource(availableVersion, metadata.sourceCommit);
+  return {
+    status: result.status,
+    currentVersion: checkedVersion(result.currentVersion),
+    availableVersion,
+    ...metadata,
+    ...(message === undefined ? {} : { message }),
+  };
+}
+
+function metadataOf(result: {
+  readonly source: string;
+  readonly sourceCommit: string;
+  readonly formula: string;
+  readonly cask: string;
+}, availableVersion: string) {
+  if (result.source !== "joshyorko/tools" || !/^[a-f0-9]{12}$/i.test(result.sourceCommit)) {
+    throw new Error("Homebrew update helper returned an invalid source commit.");
+  }
+  const formula = checkedVersion(result.formula);
+  const cask = checkedVersion(result.cask);
+  if (formula !== availableVersion || cask !== availableVersion) {
+    throw new Error("Homebrew formula and cask versions do not match.");
+  }
+  return {
+    source: result.source,
+    sourceCommit: result.sourceCommit,
+    formula,
+    cask,
+  };
+}
+
+function assertVersionSource(version: string, sourceCommit: string): void {
+  const versionSource = sourceVersionOfPackageVersion(version).split(".").at(-1);
+  if (versionSource?.toLowerCase() !== sourceCommit.toLowerCase()) {
+    throw new Error("Homebrew paired version does not match its source commit.");
+  }
+}
+
+function parsePrepared(raw: string): HomebrewUpdatePrepared {
+  const result = Schema.decodeUnknownSync(HomebrewUpdatePreparedSchema)(JSON.parse(raw));
+  const message = optionalMessage(result.message);
+  const availableVersion = checkedVersion(result.availableVersion);
+  const metadata = metadataOf(result, availableVersion);
+  assertVersionSource(availableVersion, metadata.sourceCommit);
+  return {
+    status: result.status,
+    currentVersion: checkedVersion(result.currentVersion),
+    availableVersion,
+    ...metadata,
+    ...(message === undefined ? {} : { message }),
+  };
+}
+
+function parseResult(raw: string): HomebrewUpdateResult {
+  const result = Schema.decodeUnknownSync(HomebrewUpdateResultSchema)(JSON.parse(raw));
+  const message = optionalMessage(result.message);
+  return {
+    outcome: result.outcome,
+    version: checkedVersion(result.version),
+    ...(message === undefined ? {} : { message }),
+  };
+}
+
+function invoke(input: {
+  readonly helperPath: string;
+  readonly args: ReadonlyArray<string>;
+  readonly homeDirectory: string;
+  readonly stateHome: string;
+  readonly timeout?: number;
+}): Promise<string> {
+  return new Promise((resolve, reject) => {
+    // execFile passes an argv vector directly; shell parsing is deliberately disabled.
+    execFile(
+      input.helperPath,
+      [...input.args],
+      {
+        cwd: input.homeDirectory,
+        encoding: "utf8",
+        env: minimalEnvironment(input),
+        shell: false,
+        timeout: input.timeout ?? 120_000,
+        maxBuffer: 1_048_576,
+        windowsHide: true,
+      },
+      (error, stdout, stderr) => {
+        if (error) {
+          reject(
+            new Error(safeMessage(stderr || error.message) || "Homebrew update helper failed.", {
+              cause: error,
+            }),
+          );
+          return;
+        }
+        resolve(stdout);
+      },
+    );
+  });
+}
+
+const DETACHED_RUNNER = `#!/usr/bin/env bash
+set -u
+helper_path="$1"
+private_dir="$2"
+shift 2
+cleanup() {
+  result=$?
+  trap - EXIT
+  /usr/bin/rm -rf -- "$private_dir" || true
+  exit "$result"
+}
+trap cleanup EXIT
+"$helper_path" "$@"
+`;
+
+function minimalEnvironment(input: {
+  readonly homeDirectory: string;
+  readonly stateHome: string;
+  readonly runtimeDirectory?: string;
+}): NodeJS.ProcessEnv {
+  const env: NodeJS.ProcessEnv = {
+    HOME: input.homeDirectory,
+    PATH: process.env.PATH || "/usr/bin:/bin:/usr/sbin:/sbin",
+    XDG_STATE_HOME: input.stateHome,
+  };
+  if (input.runtimeDirectory !== undefined) env.XDG_RUNTIME_DIR = input.runtimeDirectory;
+  for (const name of [
+    "XDG_CONFIG_HOME",
+    "XDG_DATA_HOME",
+    "XDG_CACHE_HOME",
+    "T3CODE_HOME",
+    "DISPLAY",
+    "WAYLAND_DISPLAY",
+    "XAUTHORITY",
+    "XDG_SESSION_TYPE",
+    "XDG_CURRENT_DESKTOP",
+    "DBUS_SESSION_BUS_ADDRESS",
+    "USER",
+    "LOGNAME",
+    "SHELL",
+    "LANG",
+    "LC_ALL",
+    "LC_CTYPE",
+    "TMPDIR",
+  ]) {
+    const value = process.env[name];
+    if (value !== undefined) env[name] = value;
+  }
+  return env;
+}
+
+async function startDetachedHelper(input: {
+  readonly helperPath: string;
+  readonly args: ReadonlyArray<string>;
+  readonly homeDirectory: string;
+  readonly runtimeDirectory: string | undefined;
+  readonly stateHome: string;
+}): Promise<void> {
+  const runtimeDirectory = input.runtimeDirectory ?? tmpdir();
+  const uid = process.getuid?.();
+  if (!isAbsolute(runtimeDirectory) || uid === undefined) {
+    throw new Error("A Linux user runtime directory is required for the Homebrew update.");
+  }
+  const runtimeStat = await lstat(runtimeDirectory);
+  if (
+    runtimeStat.isSymbolicLink() ||
+    !runtimeStat.isDirectory() ||
+    (input.runtimeDirectory !== undefined && (runtimeStat.uid !== uid || (runtimeStat.mode & 0o077) !== 0))
+  ) {
+    throw new Error("The Linux user runtime directory is not private and user-owned.");
+  }
+  const helperStat = await lstat(input.helperPath);
+  if (!helperStat.isFile() || helperStat.isSymbolicLink() || (helperStat.mode & 0o111) === 0) {
+    throw new Error("The packaged Homebrew update helper is not an executable regular file.");
+  }
+
+  const privateDirectory = await mkdtemp(join(runtimeDirectory, "t3-homebrew-update-"));
+  try {
+    await chmod(privateDirectory, 0o700);
+    const helperCopy = join(privateDirectory, "t3-homebrew-update.sh");
+    const runnerPath = join(privateDirectory, "run-update.sh");
+    const readyPath = join(privateDirectory, "ready");
+    await copyFile(input.helperPath, helperCopy);
+    await chmod(helperCopy, 0o700);
+    await writeFile(runnerPath, DETACHED_RUNNER, { mode: 0o700 });
+    await chmod(runnerPath, 0o700);
+    await new Promise<void>((resolve, reject) => {
+      const child = spawn(runnerPath, [helperCopy, privateDirectory, ...input.args, "--ready-file", readyPath], {
+        cwd: input.homeDirectory,
+        detached: true,
+        env: minimalEnvironment({
+          homeDirectory: input.homeDirectory,
+          runtimeDirectory,
+          stateHome: input.stateHome,
+        }),
+        shell: false,
+        stdio: "ignore",
+      });
+      let settled = false;
+      const finish = (error?: Error) => {
+        if (settled) return;
+        settled = true;
+        if (error) {
+          try { if (child.pid !== undefined) process.kill(-child.pid, "SIGTERM"); } catch {}
+          reject(error);
+        }
+        else { child.unref(); resolve(); }
+      };
+      child.once("error", (error) => finish(error));
+      child.once("exit", () => finish(new Error("The Homebrew helper failed before accepting the update.")));
+      // @effect-diagnostics-next-line globalDate:off -- Native readiness deadline must survive independently of the quitting Effect runtime.
+      const deadline = Date.now() + 15_000;
+      const checkReady = async () => {
+        if (settled) return;
+        try { if ((await readFile(readyPath, "utf8")) === "ready") return finish(); } catch {}
+        // @effect-diagnostics-next-line globalDate:off -- Compare the native detached-child deadline.
+        if (Date.now() >= deadline) return finish(new Error("The Homebrew helper did not become ready; Desktop remains open."));
+        // @effect-diagnostics-next-line globalTimers:off -- Poll the native child outside the Effect runtime that is about to quit.
+        setTimeout(() => void checkReady(), 20);
+      };
+      void checkReady();
+    });
+  } catch (error) {
+    await rm(privateDirectory, { recursive: true, force: true });
+    throw error;
+  }
+}
+
+export function createHomebrewDesktopUpdates(input: {
+  readonly helperPath: string;
+  readonly stateHome: string;
+  readonly homeDirectory: string;
+  readonly runtimeDirectory?: string;
+}) {
+  const runtimeDirectory = input.runtimeDirectory ?? process.env.XDG_RUNTIME_DIR;
+  return {
+    check: async (appVersion: string) =>
+      parseCheck(
+        await invoke({
+          helperPath: input.helperPath,
+          args: ["check", "--json", "--app-version", checkedVersion(appVersion)],
+          homeDirectory: input.homeDirectory,
+          stateHome: input.stateHome,
+        }),
+      ),
+    prepare: async (appVersion: string, version: string) => {
+      return parsePrepared(
+        await invoke({
+          helperPath: input.helperPath,
+          args: [
+            "prepare",
+            "--app-version",
+            checkedVersion(appVersion),
+            "--version",
+            checkedVersion(version),
+          ],
+          homeDirectory: input.homeDirectory,
+          stateHome: input.stateHome,
+          timeout: 20 * 60_000,
+        }),
+      );
+    },
+    apply: async (appVersion: string, version: string, pid: number) => {
+      if (!Number.isSafeInteger(pid) || pid < 1) throw new Error("Invalid desktop process id.");
+      await startDetachedHelper({
+        helperPath: input.helperPath,
+        homeDirectory: input.homeDirectory,
+        runtimeDirectory,
+        stateHome: input.stateHome,
+        args: [
+          "apply",
+          "--app-version",
+          checkedVersion(appVersion),
+          "--version",
+          checkedVersion(version),
+          "--wait-for-pid",
+          String(pid),
+        ],
+      });
+    },
+    takeResult: async (): Promise<HomebrewUpdateResult | undefined> => {
+      const resultPath = join(input.stateHome, RESULT_FILE);
+      let raw: string;
+      try {
+        raw = await readFile(resultPath, "utf8");
+      } catch (error) {
+        if (
+          typeof error === "object" &&
+          error !== null &&
+          "code" in error &&
+          error.code === "ENOENT"
+        ) {
+          return undefined;
+        }
+        throw error;
+      }
+      const result = parseResult(raw);
+      await unlink(resultPath);
+      return result;
+    },
+  };
+}
