+++ b/apps/desktop/src/updates/DesktopUpdates.homebrew.test.ts
@@ -0,0 +1,268 @@
+import { assert, describe, it } from "@effect/vitest";
+import { DesktopUpdateStateSchema } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import * as TestClock from "effect/testing/TestClock";
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- Integration fixtures execute the packaged native helper against real files.
+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- Fixture paths belong to the native helper process.
+import { join } from "node:path";
+
+import * as DesktopUpdates from "./DesktopUpdates.ts";
+import { makeHarness } from "./homebrewUpdatesTestHarness.ts";
+
+const HOMEBREW_CURRENT_VERSION = "main.20261106111159.6577c6b61851";
+const HOMEBREW_AVAILABLE_VERSION = "main.20261107111159.abcdef123456";
+
+function writeHomebrewHelper(
+  root: string,
+  status: "current" | "available",
+  failPrepare = false,
+  mismatch?: "check" | "prepare",
+) {
+  const availableVersion =
+    status === "current" ? HOMEBREW_CURRENT_VERSION : HOMEBREW_AVAILABLE_VERSION;
+  const sourceCommit = availableVersion.split(".").at(-1) ?? "";
+  const fields = JSON.stringify({
+    currentVersion: HOMEBREW_CURRENT_VERSION,
+    availableVersion,
+    source: "joshyorko/tools",
+    sourceCommit,
+    formula: availableVersion,
+    cask: availableVersion,
+  });
+  const check = JSON.stringify({ status, ...JSON.parse(fields),
+    ...(mismatch === "check" ? { currentVersion: HOMEBREW_AVAILABLE_VERSION } : {}),
+  });
+  const prepare = JSON.stringify({ status: "prepared", ...JSON.parse(fields),
+    ...(mismatch === "prepare" ? { currentVersion: HOMEBREW_AVAILABLE_VERSION } : {}),
+  });
+  writeFileSync(
+    join(root, "t3-homebrew-update.sh"),
+    `#!/bin/bash
+set -euo pipefail
+printf '%s\\n' "$*" >> "${join(root, "calls.txt")}"
+if [ "$1" = apply ]; then
+  while [ "$#" -gt 0 ]; do
+    if [ "$1" = --ready-file ]; then printf ready > "$2"; break; fi
+    shift
+  done
+  sleep 0.3
+fi
+if [ "$1" = check ]; then
+  printf '%s\\n' '${check}'
+fi
+if [ "$1" = prepare ]; then
+  if ${failPrepare ? "true" : "false"}; then
+    printf '%s\\n' 'Homebrew artifact fetch failed.' >&2
+    exit 1
+  fi
+  printf '%s\\n' '${prepare}'
+fi
+`,
+    { mode: 0o755 },
+  );
+}
+
+describe("DesktopUpdates Homebrew behavior", () => {
+  it.effect("uses the packaged Homebrew helper for paired updates without Electron updater polling", () => {
+    const root = mkdtempSync(join(tmpdir(), "t3-homebrew-updates-"));
+    writeHomebrewHelper(root, "available");
+    let backendStopped = false;
+    const harness = makeHarness({
+      platform: "linux",
+      appVersion: "0.1.7",
+      homebrewResourcePath: root,
+      env: { T3CODE_DESKTOP_MOCK_UPDATES: "false" },
+      stopBackend: Effect.sync(() => {
+        backendStopped = true;
+      }),
+    });
+
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        yield* updates.configure;
+        const initial = yield* updates.getState;
+        assert.equal(initial.updateProvider, "homebrew");
+        yield* Schema.decodeEffect(DesktopUpdateStateSchema)(initial);
+        assert.isFalse(Object.hasOwn(initial, "homebrewUpdateResult"));
+        assert.equal(initial.status, "idle");
+        assert.isTrue(initial.enabled);
+        assert.equal(harness.checkCount(), 0);
+        assert.equal(harness.listenerCount(), 0);
+        assert.deepEqual(harness.feedUrls(), []);
+
+        const check = yield* updates.check("manual");
+        assert.isTrue(check.checked);
+        assert.equal(check.state.status, "available");
+        assert.equal(check.state.availableVersion, HOMEBREW_AVAILABLE_VERSION);
+        assert.deepEqual(check.state.homebrewUpdate, {
+          source: "joshyorko/tools",
+          sourceCommit: "abcdef123456",
+          installedVersion: HOMEBREW_CURRENT_VERSION,
+          formula: HOMEBREW_AVAILABLE_VERSION,
+          cask: HOMEBREW_AVAILABLE_VERSION,
+        });
+
+        const prepared = yield* updates.download;
+        assert.isTrue(prepared.accepted);
+        assert.isTrue(prepared.completed);
+        assert.equal(prepared.state.status, "downloaded");
+        assert.isNull(prepared.state.downloadPercent);
+        assert.isNull(
+          harness.sentStates.find((state) => state.status === "downloading")?.downloadPercent,
+        );
+
+        const installed = yield* updates.install;
+        assert.isTrue(installed.accepted);
+        assert.isFalse(installed.completed);
+        assert.isTrue(backendStopped);
+        assert.equal(harness.quitAndInstalls(), 0);
+        assert.include(harness.installSteps, "electronApp.quit");
+        assert.equal(harness.updateRestartMarkers.size, 0);
+        assert.equal(harness.installRecords.size, 0);
+        // @effect-diagnostics-next-line globalTimers:off -- Wait for real child-process I/O while the test Effect clock is virtual.
+        yield* Effect.promise(async () => { for (let i = 0; i < 100; i++) { if (readFileSync(join(root, "calls.txt"), "utf8").includes("apply --app-version")) return; await new Promise((resolve) => setTimeout(resolve, 10)); } });
+        const calls = readFileSync(join(root, "calls.txt"), "utf8");
+        assert.include(calls, "check --json");
+        assert.include(
+          calls,
+          `prepare --app-version ${HOMEBREW_CURRENT_VERSION} --version ${HOMEBREW_AVAILABLE_VERSION}`,
+        );
+        assert.include(
+          calls,
+          `apply --app-version ${HOMEBREW_CURRENT_VERSION} ` +
+            `--version ${HOMEBREW_AVAILABLE_VERSION} --wait-for-pid`,
+        );
+      }),
+    ).pipe(
+      Effect.provide(Layer.merge(TestClock.layer(), harness.layer)),
+      Effect.ensuring(Effect.sync(() => rmSync(root, { recursive: true, force: true }))),
+    );
+  });
+
+  it.effect("does not invoke the Homebrew provider when managed policy turns updates off", () => {
+    const root = mkdtempSync(join(tmpdir(), "t3-homebrew-updates-policy-"));
+    writeHomebrewHelper(root, "available");
+    const harness = makeHarness({
+      platform: "linux",
+      appVersion: HOMEBREW_CURRENT_VERSION,
+      homebrewResourcePath: root,
+      env: { T3CODE_DESKTOP_MOCK_UPDATES: "false" },
+      policy: {
+        mode: "off",
+        feedUrl: undefined,
+        allowNightly: false,
+        message: "Example Corp manages T3 Code updates.",
+      },
+    });
+
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        yield* updates.configure;
+        const state = yield* updates.getState;
+        assert.equal(state.status, "disabled");
+        assert.equal(state.message, "Example Corp manages T3 Code updates.");
+        assert.isFalse((yield* updates.check("manual")).checked);
+        assert.equal(harness.checkCount(), 0);
+        assert.deepEqual(harness.feedUrls(), []);
+        assert.isFalse(existsSync(join(root, "calls.txt")));
+      }),
+    ).pipe(
+      Effect.provide(Layer.merge(TestClock.layer(), harness.layer)),
+      Effect.ensuring(Effect.sync(() => rmSync(root, { recursive: true, force: true }))),
+    );
+  });
+
+  it.effect("does not override an administrator's managed update feed", () => {
+    const root = mkdtempSync(join(tmpdir(), "t3-homebrew-managed-feed-"));
+    writeHomebrewHelper(root, "available");
+    const harness = makeHarness({
+      platform: "linux",
+      appVersion: HOMEBREW_CURRENT_VERSION,
+      homebrewResourcePath: root,
+      env: { T3CODE_DESKTOP_MOCK_UPDATES: "false" },
+      policy: {
+        mode: "auto",
+        feedUrl: "https://updates.example.test/t3/",
+        allowNightly: true,
+        message: "Example Corp manages T3 Code updates.",
+      },
+    });
+
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        yield* updates.configure;
+        const state = yield* updates.getState;
+        assert.equal(state.status, "disabled");
+        assert.equal(state.message, "Example Corp manages T3 Code updates.");
+        assert.isFalse((yield* updates.check("manual")).checked);
+        assert.equal(harness.checkCount(), 0);
+        assert.deepEqual(harness.feedUrls(), []);
+        assert.isFalse(existsSync(join(root, "calls.txt")));
+      }),
+    ).pipe(
+      Effect.provide(Layer.merge(TestClock.layer(), harness.layer)),
+      Effect.ensuring(Effect.sync(() => rmSync(root, { recursive: true, force: true }))),
+    );
+  });
+  for (const phase of ["check", "prepare"] as const) {
+    it.effect(`recovers from a mismatched ${phase} response and permits a retry`, () => {
+      const root = mkdtempSync(join(tmpdir(), "t3-homebrew-mismatch-"));
+      writeHomebrewHelper(root, "available", false, phase);
+      const harness = makeHarness({
+        platform: "linux",
+        appVersion: "0.1.7",
+        homebrewResourcePath: root,
+        env: { T3CODE_DESKTOP_MOCK_UPDATES: "false" },
+      });
+      return Effect.scoped(Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        yield* updates.configure;
+        if (phase === "check") {
+          assert.isFalse((yield* updates.check("manual")).checked);
+        } else {
+          assert.isTrue((yield* updates.check("manual")).checked);
+          const result = yield* updates.download;
+          assert.isTrue(result.accepted);
+          assert.isFalse(result.completed);
+        }
+        const failed = yield* updates.getState;
+        assert.equal(failed.errorContext, phase === "check" ? "check" : "download");
+        assert.isTrue(failed.canRetry);
+        assert.equal(failed.status, phase === "check" ? "error" : "available");
+        assert.notInclude(harness.installSteps, "electronApp.quit");
+        writeHomebrewHelper(root, "available");
+        assert.isTrue((yield* updates.check("manual")).checked);
+        if (phase === "prepare") assert.isTrue((yield* updates.download).completed);
+      })).pipe(
+        Effect.provide(Layer.merge(TestClock.layer(), harness.layer)),
+        Effect.ensuring(Effect.sync(() => rmSync(root, { recursive: true, force: true }))),
+      );
+    });
+  }
+
+  for (const identity of [null, "invalid JSON"]) {
+    it.effect(`disables Homebrew updates for ${identity === null ? "missing" : "invalid"} build identity`, () => {
+      const root = mkdtempSync(join(tmpdir(), "t3-homebrew-identity-"));
+      writeHomebrewHelper(root, "available");
+      const harness = makeHarness({ platform: "linux", appVersion: "0.1.7", homebrewResourcePath: root, homebrewBuildIdentity: identity, env: { T3CODE_DESKTOP_MOCK_UPDATES: "false" } });
+      return Effect.scoped(Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        yield* updates.configure;
+        const state = yield* updates.getState;
+        assert.isFalse(state.enabled);
+        assert.equal(state.status, "disabled");
+        assert.include(state.message ?? "", "identity");
+        assert.isFalse((yield* updates.check("manual")).checked);
+        assert.isFalse(existsSync(join(root, "calls.txt")));
+      })).pipe(Effect.provide(Layer.merge(TestClock.layer(), harness.layer)), Effect.ensuring(Effect.sync(() => rmSync(root, { recursive: true, force: true }))));
+    });
+  }
+
+});
