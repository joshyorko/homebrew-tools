+import { assert, describe, it } from "@effect/vitest";
+import type { DesktopUpdateState } from "@t3tools/contracts";
+
+import {
+  getDesktopUpdateButtonTooltip,
+  getDesktopUpdateInstallConfirmationMessage,
+} from "./desktopUpdate.logic.ts";
+
+const version = "main.20261106111159.6577c6b61851";
+const state: DesktopUpdateState = {
+  enabled: true,
+  status: "available",
+  channel: "latest",
+  currentVersion: "main.20261105123456.012345abcdef",
+  hostArch: "x64",
+  appArch: "x64",
+  runningUnderArm64Translation: false,
+  availableVersion: version,
+  downloadedVersion: null,
+  releaseNotes: [],
+  omittedReleaseCount: 0,
+  downloadPercent: null,
+  checkedAt: null,
+  message: null,
+  errorContext: null,
+  canRetry: false,
+  updateProvider: "homebrew",
+  homebrewUpdate: {
+    source: "joshyorko/tools",
+    sourceCommit: "6577c6b61851",
+    installedVersion: "main.20261105123456.012345abcdef",
+    formula: version,
+    cask: version,
+  },
+};
+
+describe("Homebrew Desktop update presentation", () => {
+  it("names both paired package versions and their source commit", () => {
+    const tooltip = getDesktopUpdateButtonTooltip(state);
+    assert.include(tooltip, `t3code-cli-main ${state.currentVersion} → ${version}`);
+    assert.include(tooltip, `t3-code-linux ${state.currentVersion} → ${version}`);
+    assert.include(tooltip, "joshyorko/tools");
+    assert.include(tooltip, "source commit 6577c6b61851");
+  });
+
+  it("confirms both packages, service restart, and Desktop relaunch", () => {
+    const message = getDesktopUpdateInstallConfirmationMessage({
+      ...state,
+      status: "downloaded",
+      downloadedVersion: version,
+    });
+    assert.include(message, `t3code-cli-main ${state.currentVersion} → ${version}`);
+    assert.include(message, `t3-code-linux ${state.currentVersion} → ${version}`);
+    assert.include(message, "joshyorko/tools");
+    assert.include(message, "restart the Homebrew T3 Code service");
+    assert.include(message, "relaunch T3 Code");
+    assert.include(message, "source commit: 6577c6b61851");
+  });
+
+  it("uses truthful preparation text without a fabricated byte percentage", () => {
+    const tooltip = getDesktopUpdateButtonTooltip({
+      ...state,
+      status: "downloading",
+      downloadPercent: null,
+    });
+    assert.include(tooltip, "Preparing Homebrew packages");
+    assert.notMatch(tooltip, /\d+%/);
+  });
+});
