+++ b/apps/web/src/components/homebrewDesktopUpdate.logic.ts
@@ -0,0 +1,40 @@
+import type { DesktopUpdateState } from "@t3tools/contracts";
+
+export function homebrewDesktopUpdateButtonTooltip(
+  state: DesktopUpdateState,
+): string | undefined {
+  if (state.updateProvider !== "homebrew") return undefined;
+  const version = state.downloadedVersion ?? state.availableVersion ?? state.currentVersion;
+  const sourceCommit = state.homebrewUpdate?.sourceCommit ??
+    /^main\.\d{14}\.([a-f0-9]{12,40})(?:_[0-9]+)?$/i.exec(version)?.[1];
+  const installedVersion = state.homebrewUpdate?.installedVersion ?? state.currentVersion;
+  const formulaVersion = state.homebrewUpdate?.formula ?? version;
+  const caskVersion = state.homebrewUpdate?.cask ?? version;
+  const packages = `t3code-cli-main ${installedVersion} → ${formulaVersion} and t3-code-linux ${installedVersion} → ${caskVersion}`;
+  const source = state.homebrewUpdate?.source ?? "joshyorko/tools";
+  const sourceDetails = sourceCommit ? ` from ${source} (source commit: ${sourceCommit})` : "";
+  if (state.status === "downloading") return `Preparing Homebrew packages ${packages}${sourceDetails}`;
+  if (state.status === "available") return `Homebrew update available for ${packages}${sourceDetails}. Click to prepare both packages.`;
+  if (state.status === "downloaded") return `Homebrew packages ${packages}${sourceDetails} are prepared. Click to install and restart.`;
+  return undefined;
+}
+
+export function homebrewDesktopUpdateConfirmation(
+  state: Pick<DesktopUpdateState, "availableVersion" | "downloadedVersion" | "currentVersion" | "updateProvider" | "homebrewUpdate">,
+): string | undefined {
+  const version = state.downloadedVersion ?? state.availableVersion;
+  if (state.updateProvider !== "homebrew" || version === null) return undefined;
+  const formulaVersion = state.homebrewUpdate?.formula ?? version;
+  const caskVersion = state.homebrewUpdate?.cask ?? version;
+  const source = state.homebrewUpdate?.source ?? "joshyorko/tools";
+  const sourceCommit = state.homebrewUpdate?.sourceCommit ??
+    /^main\.\d{14}\.([a-f0-9]{12,40})(?:_[0-9]+)?$/i.exec(version)?.[1];
+  const installedVersion = state.homebrewUpdate?.installedVersion ?? state.currentVersion;
+  const sourceDetails = sourceCommit ? ` from ${source} (source commit: ${sourceCommit})` : "";
+  const action = [
+    `Upgrade t3code-cli-main ${installedVersion} → ${formulaVersion}`,
+    `and t3-code-linux ${installedVersion} → ${caskVersion}${sourceDetails},`,
+    "verify the paired versions, restart the Homebrew T3 Code service, and relaunch T3 Code?",
+  ].join(" ");
+  return `${action}\n\nT3 Code and its local servers will close during the update. Make sure running tasks are ready to stop.`;
+}
