diff --git a/apps/web/src/components/sidebar/useHomebrewUpdateResult.ts b/apps/web/src/components/sidebar/useHomebrewUpdateResult.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d1d8897ec21e406e758352124c9cba519751564e
--- /dev/null
+++ b/apps/web/src/components/sidebar/useHomebrewUpdateResult.ts
@@ -0,0 +1,22 @@
+import type { DesktopUpdateState } from "@t3tools/contracts";
+import { useEffect, useRef } from "react";
+import { stackedThreadToast, toastManager } from "../ui/toast";
+
+export function useHomebrewUpdateResult(
+  result: DesktopUpdateState["homebrewUpdateResult"] | undefined,
+): void {
+  const shownResult = useRef<string | null>(null);
+  useEffect(() => {
+    if (!result) return;
+    const key = `${result.outcome}:${result.version}:${result.message ?? ""}`;
+    if (shownResult.current === key) return;
+    shownResult.current = key;
+    toastManager.add(stackedThreadToast({
+      type: result.outcome === "installed" ? "success" : "error",
+      title: result.outcome === "installed" ? "Homebrew update installed" : "Homebrew update failed",
+      description: result.message ?? (result.outcome === "installed"
+        ? `T3 Code was updated to ${result.version}.`
+        : `T3 Code could not be updated to ${result.version}.`),
+    }));
+  }, [result]);
+}
