@@ -0,0 +1,96 @@
+import { assert, describe, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import { rejects } from "node:assert/strict";
+import { chmod, mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { createHomebrewDesktopUpdateProvider } from "./HomebrewDesktopUpdateProvider.ts";
+
+const version = "main.20261106111159.6577c6b61851";
+const nextVersion = "main.20261107111159.abcdef123456";
+const updateFields = `"currentVersion":"${version}","availableVersion":"${nextVersion}","source":"joshyorko/tools","sourceCommit":"abcdef123456","formula":"${nextVersion}","cask":"${nextVersion}"`;
+
+describe("HomebrewDesktopUpdateProvider", () => {
+  it.effect("passes fixed argv to check, prepare, and supervised apply", () =>
+    Effect.promise(async () => {
+      const root = await mkdtemp(join(tmpdir(), "t3-homebrew-provider-"));
+      try {
+        const helper = join(root, "t3-homebrew-update.sh");
+        const calls = join(root, "calls.jsonl");
+        await writeFile(
+          helper,
+          `#!/usr/bin/env node\nconst fs = require("node:fs")\nconst path = require("node:path")\nconst args = process.argv.slice(2)\nfs.appendFileSync(path.join(process.env.HOME, "calls.jsonl"), JSON.stringify(args) + "\\n")\nif (args[0] === "check") process.stdout.write(JSON.stringify({ status: "available", ${updateFields} }))\nif (args[0] === "prepare") process.stdout.write(JSON.stringify({ status: "prepared", ${updateFields} }))\n`,
+          { mode: 0o755 },
+        );
+        await chmod(helper, 0o755);
+        const provider = createHomebrewDesktopUpdateProvider({ helperPath: helper, stateHome: join(root, "state"), homeDirectory: root, runtimeDirectory: root });
+        const check = await provider.check(version);
+        const prepared = await provider.prepare(version, nextVersion);
+        assert.equal(prepared.formula, nextVersion);
+        assert.equal(prepared.cask, nextVersion);
+        await provider.apply(version, nextVersion, 1234);
+        assert.deepEqual(check, {
+          status: "available",
+          currentVersion: version,
+          availableVersion: nextVersion,
+          source: "joshyorko/tools",
+          sourceCommit: "abcdef123456",
+          formula: nextVersion,
+          cask: nextVersion,
+        });
+        for (let attempt = 0; attempt < 100; attempt++) {
+          if ((await readFile(calls, "utf8")).trim().split("\n").length === 3) break;
+          await new Promise((resolve) => setTimeout(resolve, 10));
+        }
+        assert.deepEqual(
+          (await readFile(calls, "utf8")).trim().split("\n").map((line) => JSON.parse(line)),
+          [
+            ["check", "--json", "--app-version", version],
+            ["prepare", "--app-version", version, "--version", nextVersion],
+            ["apply", "--app-version", version, "--version", nextVersion, "--wait-for-pid", "1234"],
+          ],
+        );
+      } finally {
+        await rm(root, { recursive: true, force: true });
+      }
+    }),
+  );
+
+  it.effect("rejects unsafe package versions before invoking the helper", () =>
+    Effect.promise(async () => {
+      const root = await mkdtemp(join(tmpdir(), "t3-homebrew-provider-"));
+      try {
+        const helper = join(root, "t3-homebrew-update.sh");
+        const calls = join(root, "calls.jsonl");
+        await writeFile(
+          helper,
+          `#!/usr/bin/env node\nrequire("node:fs").appendFileSync(require("node:path").join(__dirname, "calls.jsonl"), "called\\n")\n`,
+          { mode: 0o755 },
+        );
+        const provider = createHomebrewDesktopUpdateProvider({ helperPath: helper, stateHome: join(root, "state"), homeDirectory: root, runtimeDirectory: root });
+        await rejects(provider.prepare(version, "main.1; touch /tmp/should-not-run"));
+        await rejects(readFile(calls, "utf8"));
+      } finally {
+        await rm(root, { recursive: true, force: true });
+      }
+    }),
+  );
+
+  it.effect("consumes the helper's post-relaunch result exactly once", () =>
+    Effect.promise(async () => {
+      const root = await mkdtemp(join(tmpdir(), "t3-homebrew-provider-"));
+      try {
+        const stateHome = join(root, "state");
+        const resultPath = join(stateHome, "t3code", "homebrew-update", "result.json");
+        await mkdir(join(stateHome, "t3code", "homebrew-update"), { recursive: true });
+        await writeFile(resultPath, JSON.stringify({ outcome: "installed", version }));
+        const provider = createHomebrewDesktopUpdateProvider({ helperPath: join(root, "unused"), stateHome, homeDirectory: root });
+        assert.deepEqual(await provider.takeResult(), { outcome: "installed", version });
+        assert.equal(await provider.takeResult(), undefined);
+      } finally {
+        await rm(root, { recursive: true, force: true });
+      }
+    }),
+  );
+});
diff --git a/apps/desktop/src/updates/HomebrewDesktopUpdateProvider.ts b/apps/desktop/src/updates/HomebrewDesktopUpdateProvider.ts
new file mode 100644
index 0000000..aa35914
--- /dev/null
+++ b/apps/desktop/src/updates/HomebrewDesktopUpdateProvider.ts
@@ -0,0 +1,358 @@
+import { execFile, spawn } from "node:child_process";
+import { chmod, copyFile, lstat, mkdtemp, readFile, rm, unlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { isAbsolute, join } from "node:path";
+import * as Schema from "effect/Schema";
+
+const HomebrewUpdateCheckSchema = Schema.Struct({
+  status: Schema.Literals(["current", "available"]),
+  currentVersion: Schema.String,
+  availableVersion: Schema.String,
+  source: Schema.String,
+  sourceCommit: Schema.String,
+  formula: Schema.String,
+  cask: Schema.String,
+  message: Schema.optionalKey(Schema.String),
+});
+export type HomebrewUpdateCheck = typeof HomebrewUpdateCheckSchema.Type;
+
+const HomebrewUpdatePreparedSchema = Schema.Struct({
+  status: Schema.Literal("prepared"),
+  currentVersion: Schema.String,
+  availableVersion: Schema.String,
+  source: Schema.String,
+  sourceCommit: Schema.String,
+  formula: Schema.String,
+  cask: Schema.String,
+  message: Schema.optionalKey(Schema.String),
+});
+export type HomebrewUpdatePrepared = typeof HomebrewUpdatePreparedSchema.Type;
+
+const HomebrewUpdateResultSchema = Schema.Struct({
+  outcome: Schema.Literals(["installed", "failed"]),
+  version: Schema.String,
+  message: Schema.optionalKey(Schema.String),
+});
+export type HomebrewUpdateResult = typeof HomebrewUpdateResultSchema.Type;
+
+const VERSION = /^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$/;
+const RESULT_FILE = "t3code/homebrew-update/result.json";
+
+export function sourceVersionOfPackageVersion(value: string): string {
+  const sourceVersion = /^main\.\d{14}\.[a-f0-9]{12}(?:_[0-9]+)?$/i.exec(value)?.[0];
+  if (sourceVersion === undefined) {
+    throw new Error("Homebrew package version is not a recognized T3 build.");
+  }
+  return sourceVersion.replace(/_[0-9]+$/, "");
+}
+
+function checkedVersion(value: unknown): string {
+  if (typeof value !== "string" || !VERSION.test(value)) {
+    throw new Error("Homebrew update helper returned an invalid version.");
+  }
+  return value;
+}
+
+function safeMessage(value: string): string {
+  return value
+    .split(/[\r\n\0]/, 1)[0]
+    ?.trim()
+    .slice(0, 1024)
+    .replace(/\b(?:https?|file):\/\/[^\s"'<>]+/gi, "[redacted URL]")
+    .replace(/\b(?:Bearer|Basic)\s+[^\s,;]+/gi, "[redacted credential]") ?? "";
+}
+
+function optionalMessage(value: unknown): string | undefined {
+  if (value === undefined) return undefined;
+  if (typeof value !== "string") {
+    throw new Error("Homebrew update helper returned an invalid message.");
+  }
+  return safeMessage(value);
+}
+
+function parseCheck(raw: string): HomebrewUpdateCheck {
+  const result = Schema.decodeUnknownSync(HomebrewUpdateCheckSchema)(JSON.parse(raw));
+  const message = optionalMessage(result.message);
+  const availableVersion = checkedVersion(result.availableVersion);
+  const metadata = metadataOf(result, availableVersion);
+  assertVersionSource(availableVersion, metadata.sourceCommit);
+  return {
+    status: result.status,
+    currentVersion: checkedVersion(result.currentVersion),
+    availableVersion,
+    ...metadata,
+    ...(message === undefined ? {} : { message }),
+  };
+}
+
+function metadataOf(result: {
+  readonly source: string;
+  readonly sourceCommit: string;
+  readonly formula: string;
+  readonly cask: string;
+}, availableVersion: string) {
+  if (result.source !== "joshyorko/tools" || !/^[a-f0-9]{12}$/i.test(result.sourceCommit)) {
+    throw new Error("Homebrew update helper returned an invalid source commit.");
+  }
+  const formula = checkedVersion(result.formula);
+  const cask = checkedVersion(result.cask);
+  if (formula !== availableVersion || cask !== availableVersion) {
+    throw new Error("Homebrew formula and cask versions do not match.");
+  }
+  return {
+    source: result.source,
+    sourceCommit: result.sourceCommit,
+    formula,
+    cask,
+  };
+}
+
+function assertVersionSource(version: string, sourceCommit: string): void {
+  const versionSource = sourceVersionOfPackageVersion(version).split(".").at(-1);
+  if (versionSource?.toLowerCase() !== sourceCommit.toLowerCase()) {
+    throw new Error("Homebrew paired version does not match its source commit.");
+  }
+}
+
+function parsePrepared(raw: string): HomebrewUpdatePrepared {
+  const result = Schema.decodeUnknownSync(HomebrewUpdatePreparedSchema)(JSON.parse(raw));
+  const message = optionalMessage(result.message);
+  const availableVersion = checkedVersion(result.availableVersion);
+  const metadata = metadataOf(result, availableVersion);
+  assertVersionSource(availableVersion, metadata.sourceCommit);
+  return {
+    status: result.status,
+    currentVersion: checkedVersion(result.currentVersion),
+    availableVersion,
+    ...metadata,
+    ...(message === undefined ? {} : { message }),
+  };
+}
+
+function parseResult(raw: string): HomebrewUpdateResult {
+  const result = Schema.decodeUnknownSync(HomebrewUpdateResultSchema)(JSON.parse(raw));
+  const message = optionalMessage(result.message);
+  return {
+    outcome: result.outcome,
+    version: checkedVersion(result.version),
+    ...(message === undefined ? {} : { message }),
+  };
+}
+
+function invoke(input: {
+  readonly helperPath: string;
+  readonly args: ReadonlyArray<string>;
+  readonly homeDirectory: string;
+  readonly stateHome: string;
+  readonly timeout?: number;
+}): Promise<string> {
+  return new Promise((resolve, reject) => {
+    // execFile passes an argv vector directly; shell parsing is deliberately disabled.
+    execFile(
+      input.helperPath,
+      [...input.args],
+      {
+        cwd: input.homeDirectory,
+        encoding: "utf8",
+        env: minimalEnvironment(input),
+        shell: false,
+        timeout: input.timeout ?? 120_000,
+        maxBuffer: 1_048_576,
+        windowsHide: true,
+      },
+      (error, stdout, stderr) => {
+        if (error) {
+          reject(
+            new Error(safeMessage(stderr || error.message) || "Homebrew update helper failed.", {
+              cause: error,
+            }),
+          );
+          return;
+        }
+        resolve(stdout);
+      },
+    );
+  });
+}
+
+const DETACHED_RUNNER = `#!/usr/bin/env bash
+set -u
+helper_path="$1"
+private_dir="$2"
+shift 2
+cleanup() {
+  result=$?
+  trap - EXIT
+  /usr/bin/rm -rf -- "$private_dir" || true
+  exit "$result"
+}
+trap cleanup EXIT
+"$helper_path" "$@"
+`;
+
+function minimalEnvironment(input: {
+  readonly homeDirectory: string;
+  readonly stateHome: string;
+  readonly runtimeDirectory?: string;
+}): NodeJS.ProcessEnv {
+  const env: NodeJS.ProcessEnv = {
+    HOME: input.homeDirectory,
+    PATH: process.env.PATH || "/usr/bin:/bin:/usr/sbin:/sbin",
+    XDG_STATE_HOME: input.stateHome,
+  };
+  if (input.runtimeDirectory !== undefined) env.XDG_RUNTIME_DIR = input.runtimeDirectory;
+  for (const name of [
+    "XDG_CONFIG_HOME",
+    "DISPLAY",
+    "WAYLAND_DISPLAY",
+    "XAUTHORITY",
+    "XDG_SESSION_TYPE",
+    "XDG_CURRENT_DESKTOP",
+    "DBUS_SESSION_BUS_ADDRESS",
+    "USER",
+    "LOGNAME",
+    "SHELL",
+    "LANG",
+    "LC_ALL",
+    "LC_CTYPE",
+    "TMPDIR",
+  ]) {
+    const value = process.env[name];
+    if (value !== undefined) env[name] = value;
+  }
+  return env;
+}
+
+async function startDetachedHelper(input: {
+  readonly helperPath: string;
+  readonly args: ReadonlyArray<string>;
+  readonly homeDirectory: string;
+  readonly runtimeDirectory: string | undefined;
+  readonly stateHome: string;
+}): Promise<void> {
+  const runtimeDirectory = input.runtimeDirectory ?? tmpdir();
+  const uid = process.getuid?.();
+  if (!isAbsolute(runtimeDirectory) || uid === undefined) {
+    throw new Error("A Linux user runtime directory is required for the Homebrew update.");
+  }
+  const runtimeStat = await lstat(runtimeDirectory);
+  if (
+    runtimeStat.isSymbolicLink() ||
+    !runtimeStat.isDirectory() ||
+    (input.runtimeDirectory !== undefined && (runtimeStat.uid !== uid || (runtimeStat.mode & 0o077) !== 0))
+  ) {
+    throw new Error("The Linux user runtime directory is not private and user-owned.");
+  }
+  const helperStat = await lstat(input.helperPath);
+  if (!helperStat.isFile() || helperStat.isSymbolicLink() || (helperStat.mode & 0o111) === 0) {
+    throw new Error("The packaged Homebrew update helper is not an executable regular file.");
+  }
+
+  const privateDirectory = await mkdtemp(join(runtimeDirectory, "t3-homebrew-update-"));
+  try {
+    await chmod(privateDirectory, 0o700);
+    const helperCopy = join(privateDirectory, "t3-homebrew-update.sh");
+    const runnerPath = join(privateDirectory, "run-update.sh");
+    await copyFile(input.helperPath, helperCopy);
+    await chmod(helperCopy, 0o700);
+    await writeFile(runnerPath, DETACHED_RUNNER, { mode: 0o700 });
+    await chmod(runnerPath, 0o700);
+    await new Promise<void>((resolve, reject) => {
+      const child = spawn(runnerPath, [helperCopy, privateDirectory, ...input.args], {
+        cwd: input.homeDirectory,
+        detached: true,
+        env: minimalEnvironment({
+          homeDirectory: input.homeDirectory,
+          runtimeDirectory,
+          stateHome: input.stateHome,
+        }),
+        shell: false,
+        stdio: "ignore",
+      });
+      child.once("error", reject);
+      child.once("spawn", () => {
+        child.removeAllListeners("error");
+        child.unref();
+        resolve();
+      });
+    });
+  } catch (error) {
+    await rm(privateDirectory, { recursive: true, force: true });
+    throw error;
+  }
+}
+
+export function createHomebrewDesktopUpdateProvider(input: {
+  readonly helperPath: string;
+  readonly stateHome: string;
+  readonly homeDirectory: string;
+  readonly runtimeDirectory?: string;
+}) {
+  const runtimeDirectory = input.runtimeDirectory ?? process.env.XDG_RUNTIME_DIR;
+  return {
+    check: async (appVersion: string) =>
+      parseCheck(
+        await invoke({
+          helperPath: input.helperPath,
+          args: ["check", "--json", "--app-version", checkedVersion(appVersion)],
+          homeDirectory: input.homeDirectory,
+          stateHome: input.stateHome,
+        }),
+      ),
+    prepare: async (appVersion: string, version: string) => {
+      return parsePrepared(
+        await invoke({
+          helperPath: input.helperPath,
+          args: [
+            "prepare",
+            "--app-version",
+            checkedVersion(appVersion),
+            "--version",
+            checkedVersion(version),
+          ],
+          homeDirectory: input.homeDirectory,
+          stateHome: input.stateHome,
+          timeout: 20 * 60_000,
+        }),
+      );
+    },
+    apply: async (appVersion: string, version: string, pid: number) => {
+      if (!Number.isSafeInteger(pid) || pid < 1) throw new Error("Invalid desktop process id.");
+      await startDetachedHelper({
+        helperPath: input.helperPath,
+        homeDirectory: input.homeDirectory,
+        runtimeDirectory,
+        stateHome: input.stateHome,
+        args: [
+          "apply",
+          "--app-version",
+          checkedVersion(appVersion),
+          "--version",
+          checkedVersion(version),
+          "--wait-for-pid",
+          String(pid),
+        ],
+      });
+    },
+    takeResult: async (): Promise<HomebrewUpdateResult | undefined> => {
+      const resultPath = join(input.stateHome, RESULT_FILE);
+      let raw: string;
+      try {
+        raw = await readFile(resultPath, "utf8");
+      } catch (error) {
+        if (
+          typeof error === "object" &&
+          error !== null &&
+          "code" in error &&
+          error.code === "ENOENT"
+        ) {
+          return undefined;
+        }
+        throw error;
+      }
+      const result = parseResult(raw);
+      await unlink(resultPath);
+      return result;
+    },
+  };
+}
