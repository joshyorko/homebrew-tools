+import { BOOT_SERVICE_UNIT_FILE } from "./bootService.ts";
+import { isExactServiceVersion, SERVICE_UNIT_ENV } from "./serviceProtocol.ts";
+import { ServiceProtectionError } from "./serviceProtection.ts";
+
+export const HOMEBREW_SERVICE_UNIT = "sh.brew.t3code-cli-main.service";
+export type ProtectionUnit = typeof BOOT_SERVICE_UNIT_FILE | typeof HOMEBREW_SERVICE_UNIT;
+export interface ProtectionTarget {
+  readonly unit: ProtectionUnit;
+  readonly userUnitDir: string;
+  readonly state: "running" | "stopped";
+  readonly restartCommand: string;
+  readonly fingerprint: string;
+}
+export interface ProtectionTargetInput {
+  readonly baseDir: string;
+  readonly userUnitDir: string;
+  readonly uid: number;
+}
+
+const refuse = (reason: string) =>
+  new ServiceProtectionError({ step: `verify T3 service ownership: ${reason}` });
+const properties =
+  "Id,LoadState,ActiveState,MainPID,FragmentPath,ExecStart,Environment,EnvironmentFiles,ControlGroup";
+const safePath = /^\/[A-Za-z0-9_./@+\-]+$/;
+const showValues = (text: string) =>
+  new Map(
+    text
+      .trim()
+      .split("\n")
+      .map((line) => {
+        const separator = line.indexOf("=");
+        return [line.slice(0, separator), line.slice(separator + 1)];
+      }),
+  );
+
+export function environmentWords(text: string): ReadonlyArray<string> | undefined {
+  const words: string[] = [];
+  let word = "";
+  let quote = "";
+  for (let i = 0; i < text.length; i++) {
+    const char = text[i];
+    if (char === undefined) break;
+    if (char === "\\") {
+      const escaped = text[++i];
+      if (escaped === undefined || !['"', "'", "\\", " "].includes(escaped)) return undefined;
+      word += escaped;
+    } else if (quote !== "") {
+      if (char === quote) quote = "";
+      else word += char;
+    } else if (char === '"' || char === "'") quote = char;
+    else if (char === " ") {
+      if (word !== "") words.push(word);
+      word = "";
+    } else word += char;
+  }
+  if (quote !== "") return undefined;
+  if (word !== "") words.push(word);
+  return words;
+}
+
+const query = Effect.fn("ServiceProtectionTarget.query")(function* (
+  command: string,
+  args: ReadonlyArray<string>,
+) {
+  const runner = yield* ProcessRunner.ProcessRunner;
+  const result = yield* runner.run({ command, args, timeout: "10 seconds" });
+  const missingUnit =
+    command === "systemctl" &&
+    result.code === 1 &&
+    showValues(result.stdout).get("LoadState") === "not-found";
+  if (
+    (!missingUnit && result.code !== 0) ||
+    result.timedOut ||
+    result.stdoutTruncated ||
+    result.stdoutInvalidUtf8
