+    const environment = `T3CODE_HOME=${baseDir}${unit === NATIVE ? ` T3_BOOT_SERVICE_UNIT=${NATIVE}` : ""}`;
+    const values = new Map([
+      ["Id", unit],
+      ["LoadState", state === undefined ? "not-found" : state === "masked" ? "masked" : "loaded"],
+      ["ActiveState", running ? "active" : "inactive"],
+      ["MainPID", running ? String(pid) : "0"],
+      ["FragmentPath", `${userUnitDir}/${unit}`],
