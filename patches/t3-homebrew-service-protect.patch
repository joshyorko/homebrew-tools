+  const keg = NodePath.join(brewRoot, "Cellar/t3code-cli-main/main.test");
+  const prefix = NodePath.join(brewRoot, "opt/t3code-cli-main");
+  const uid = process.getuid!();
+  for (const directory of [
+    nativeDir,
+    userUnitDir,
+    NodePath.join(keg, "bin"),
+    NodePath.join(keg, "libexec/dist"),
+    NodePath.dirname(prefix),
+  ]) {
+    NodeFS.mkdirSync(directory, { recursive: true });
+  }
+  const nativeProgram = NodePath.join(nativeDir, "t3");
+  NodeFS.writeFileSync(nativeProgram, "native fixture executable", { mode: 0o755 });
+  NodeFS.writeFileSync(NodePath.join(nativeDir, ".install-complete"), "0.1.9\n");
+  NodeFS.symlinkSync(keg, prefix);
+  const brewProgram = `${prefix}/bin/t3`;
+  const brewEntry = `${keg}/libexec/dist/bin.mjs`;
+  const brewNode = `${brewRoot}/opt/node@24/bin/node`;
+  NodeFS.mkdirSync(NodePath.dirname(brewNode), { recursive: true });
+  NodeFS.symlinkSync(process.execPath, brewNode);
