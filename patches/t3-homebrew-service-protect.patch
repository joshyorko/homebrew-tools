+
+const NATIVE = "t3code.service";
+type UnitState = "running" | "stopped" | "masked";
+
+function fixture(states: { native?: UnitState; homebrew?: UnitState }) {
+  const root = NodeFS.mkdtempSync(NodePath.join(NodeOS.tmpdir(), "t3-protection-target-"));
+  const baseDir = NodePath.join(root, ".t3");
+  const userUnitDir = NodePath.join(root, ".config/systemd/user");
+  const nativeDir = NodePath.join(baseDir, "runtime/versions/0.1.9");
